body {
    margin: 0;
    padding: 0;
    font-family: 'Segoe UI', Arial, sans-serif;
    background: #eef1f7;
}

/* Main Container */
.modern-login-container {
    width: 95%;
    max-width: 1400px;
    min-height: 90vh;
    margin: 30px auto;
    display: flex;
    background: rgba(255, 255, 255, 0.85);
    border-radius: 30px;
    overflow: hidden;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.08);
    backdrop-filter: blur(10px);
}

/* =========================
   LEFT PANEL
========================= */
.modern-login-image {
    width: 50%;
    background: linear-gradient(135deg, #c084fc, #a855f7);
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 40px;
}

.image-overlay {
    text-align: center;
    color: white;
}

.library-illustration {
    width: 80%;
    max-width: 380px;
    margin-bottom: 30px;
    animation: float 3s ease-in-out infinite;
}

.image-overlay h1 {
    font-size: 2.2rem;
    font-weight: 700;
    margin-bottom: 15px;
}

.image-overlay p {
    font-size: 1rem;
    line-height: 1.7;
    max-width: 420px;
    margin: 0 auto;
    opacity: 0.95;
}

/* Floating animation */
@keyframes float {
    0%, 100% {
        transform: translateY(0px);
    }

    50% {
        transform: translateY(-10px);
    }
}

/* =========================
   RIGHT PANEL
========================= */
.modern-login-form {
    width: 50%;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 50px;
    background: linear-gradient(to bottom right, #ffffff, #f8fafc);
}

.modern-login-card {
    width: 100%;
    max-width: 420px;
}

/* Top Register Link */
.top-link {
    text-align: right;
    font-size: 14px;
    margin-bottom: 50px;
    color: #6b7280;
}

.top-link a {
    color: #3b82f6;
    font-weight: 600;
    text-decoration: none;
}

.top-link a:hover {
    text-decoration: underline;
}

/* Headings */
.modern-login-card h2 {
    font-size: 2.2rem;
    color: #1f2937;
    margin-bottom: 10px;
    font-weight: 700;
}

.subtitle {
    color: #6b7280;
    margin-bottom: 35px;
    font-size: 15px;
}

/* Inputs */
.input-group {
    margin-bottom: 20px;
}

.form-control {
    width: 100%;
    padding: 14px 18px;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    font-size: 15px;
    background: #ffffff;
    transition: all 0.3s ease;
    box-sizing: border-box;
}

.form-control:focus {
    outline: none;
    border-color: #a855f7;
    box-shadow: 0 0 0 4px rgba(168, 85, 247, 0.15);
}

/* Remember / Forgot Password */
.options-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 25px;
    font-size: 14px;
}

.remember-me {
    display: flex;
    align-items: center;
    gap: 8px;
    color: #4b5563;
}

.forgot-link {
    color: #6b7280;
    text-decoration: none;
}

.forgot-link:hover {
    color: #3b82f6;
}

/* Button */
.signin-btn {
    width: 100%;
    border: none;
    background: linear-gradient(135deg, #f87171, #ef4444);
    color: white;
    padding: 14px;
    border-radius: 12px;
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    box-shadow: 0 10px 25px rgba(239, 68, 68, 0.25);
}

.signin-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 15px 30px rgba(239, 68, 68, 0.35);
}

/* Bottom Register Link */
.mobile-register {
    margin-top: 25px;
    text-align: center;
    font-size: 14px;
    color: #6b7280;
}

.mobile-register a {
    color: #3b82f6;
    font-weight: 600;
    text-decoration: none;
}

.mobile-register a:hover {
    text-decoration: underline;
}

/* Validation */
.text-danger {
    display: block;
    margin-top: 6px;
    font-size: 13px;
    color: #dc2626;
}

/* =========================
   RESPONSIVE
========================= */
@media (max-width: 900px) {
    .modern-login-container {
        flex-direction: column;
        width: 95%;
        margin: 20px auto;
    }

    .modern-login-image,
    .modern-login-form {
        width: 100%;
    }

    .modern-login-image {
        padding: 30px 20px;
    }

    .library-illustration {
        width: 60%;
        max-width: 220px;
    }

    .modern-login-form {
        padding: 30px 20px;
    }

    .top-link {
        text-align: center;
        margin-bottom: 30px;
    }

    .modern-login-card h2 {
        text-align: center;
    }

    .subtitle {
        text-align: center;
    }

    .options-row {
        flex-direction: column;
        gap: 10px;
        align-items: flex-start;
    }
}