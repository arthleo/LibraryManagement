@page
@model LoginModel

@{
    ViewData["Title"] = "Login";
}

<div class="login-page" style="text-align:center;">

    <!-- Left Side -->
    <div class="login-left" style="text-align:center;">

        <h1 style="text-align:center;">📚 Library Management System</h1>

        <p style="text-align:center;">
            Browse books, manage borrowing,
            and explore your library online.
        </p>

    </div>

    <!-- Right Side -->
    <div class="login-right" style="text-align:center;">

        <div class="login-card" style="text-align:center;">

            <h2 style="text-align:center;">Welcome Back  </h2>

            <p class="login-text" style="text-align:center;">
                Login to continue
            </p>

            <form id="account" method="post" style="text-align:center;">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger" style="text-align:center;">
                </div>

                <!-- Email -->
                <div class="input-group" style="text-align:center;">

                    <label style="text-align:center;"> Email</label>

                    <input asp-for="Input.Email"
                           class="form-control"
                           placeholder="Enter your email" />

                    <span asp-validation-for="Input.Email"
                          class="text-danger">
                    </span>

                </div>

                <!-- Password -->
                <div class="input-group" style="text-align:center;">

                    <label style="text-align:center;">Password</label>

                    <input asp-for="Input.Password"
                           class="form-control"
                           placeholder="Enter password" />

                    <span asp-validation-for="Input.Password"
                          class="text-danger">
                    </span>

                </div>
<br>
                <!-- Remember Me -->
                <div class="remember-box" style="text-align:center;">

                    <input class="form-check-input"
                           asp-for="Input.RememberMe" />

                    <label asp-for="Input.RememberMe" style="text-align:center;">
                        Remember Me
                    </label>

                </div>
<br>
                <!-- Login Button -->
                <button type="submit"
                        class="login-btn" style="text-align:center;">

                    Login

                </button>
<br>
                <!-- Links -->
                <div class="extra-links" style="text-align:center">

                    <a asp-page="./ForgotPassword" style="text-align:center;">
                        Forgot Password?
                    </a>

                    <a asp-page="./Register" style="text-align:center;">
                        Create Account
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
