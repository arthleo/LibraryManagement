@page
@model LoginModel
@{
    ViewData["Title"] = "Log in";
}

<style>
    *, *::before, *::after {
        box-sizing: border-box;
    }

    body {
        background-color: #f5f0e8;
        min-height: 100vh;
    }

    .auth-wrapper {
        min-height: calc(100vh - 64px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 3rem 1rem;
    }

    .auth-card {
        background: #fff;
        border: 2px solid #000;
        box-shadow: 6px 6px 0 #000;
        width: 100%;
        max-width: 420px;
        padding: 2.5rem 2.25rem;
    }

    .auth-card__eyebrow {
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        color: #c0392b;
        margin: 0 0 0.5rem;
    }

    .auth-card__title {
        font-size: 2rem;
        font-weight: 900;
        letter-spacing: -0.03em;
        color: #111;
        margin: 0 0 0.25rem;
        line-height: 1;
    }

    .auth-card__subtitle {
        font-size: 0.875rem;
        color: #666;
        margin: 0 0 2rem;
    }

    .form-row {
        margin-bottom: 1.25rem;
    }

        .form-row label {
            display: block;
            font-size: 0.72rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            color: #333;
            margin-bottom: 0.4rem;
        }

    .input {
        width: 100%;
        max-width: 100%;
        padding: 0.875rem;
        font-size: 1rem;
        border: 1.5px solid #000;
        border-radius: 0.5rem;
        box-shadow: 2.5px 3px 0 #000;
        outline: none;
        transition: ease 0.25s;
        background: #fff;
        color: #111;
    }

        .input:focus {
            box-shadow: 5.5px 7px 0 black;
        }

        .input.is-invalid {
            border-color: #c0392b;
            box-shadow: 2.5px 3px 0 #c0392b;
        }

    .field-validation-error {
        display: block;
        font-size: 0.75rem;
        color: #c0392b;
        margin-top: 0.3rem;
    }

    .checkbox-row {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        margin-bottom: 1.5rem;
    }

        .checkbox-row input[type="checkbox"] {
            width: 1.1rem;
            height: 1.1rem;
            accent-color: #c0392b;
            cursor: pointer;
        }

        .checkbox-row label {
            font-size: 0.8rem;
            color: #444;
            cursor: pointer;
            margin: 0;
        }

    .btn-login {
        width: 100%;
        padding: 0.875rem;
        background: #c0392b;
        color: #fff;
        font-size: 0.9rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        border: 1.5px solid #000;
        border-radius: 0.5rem;
        box-shadow: 3px 3.5px 0 #000;
        cursor: pointer;
        transition: ease 0.2s;
    }

        .btn-login:hover {
            box-shadow: 5.5px 7px 0 #000;
            transform: translate(-1px, -1px);
        }

        .btn-login:active {
            box-shadow: 1px 1.5px 0 #000;
            transform: translate(1.5px, 2px);
        }

    .auth-card__links {
        display: flex;
        justify-content: space-between;
        margin-top: 1.25rem;
        padding-top: 1.25rem;
        border-top: 1px dashed #ccc;
    }

        .auth-card__links a {
            font-size: 0.75rem;
            color: #c0392b;
            text-decoration: none;
            font-weight: 700;
            border-bottom: 1.5px solid #c0392b;
            transition: color 0.2s;
        }

            .auth-card__links a:hover {
                color: #000;
                border-bottom-color: #000;
            }

    .validation-summary-errors {
        background: #fff5f5;
        border: 1.5px solid #c0392b;
        border-radius: 0.5rem;
        padding: 0.75rem 1rem;
        margin-bottom: 1.25rem;
    }

        .validation-summary-errors ul {
            margin: 0;
            padding: 0 0 0 1.1rem;
        }

        .validation-summary-errors li {
            font-size: 0.8rem;
            color: #c0392b;
        }
</style>

<div class="auth-wrapper">
    <div class="auth-card">
        <p class="auth-card__eyebrow">Library Management System</p>
        <h1 class="auth-card__title">Welcome back.</h1>
        <p class="auth-card__subtitle">Sign in to continue browsing.</p>

        <form id="account" method="post">
            <div asp-validation-summary="ModelOnly" class="validation-summary-errors" role="alert"></div>

            <div class="form-row">
                <label asp-for="Input.Email">Email</label>
                <input asp-for="Input.Email"
                       class="input"
                       autocomplete="username"
                       placeholder="you@example.com" />
                <span asp-validation-for="Input.Email" class="field-validation-error"></span>
            </div>

            <div class="form-row">
                <label asp-for="Input.Password">Password</label>
                <input asp-for="Input.Password"
                       class="input"
                       autocomplete="current-password"
                       placeholder="••••••••" />
                <span asp-validation-for="Input.Password" class="field-validation-error"></span>
            </div>

            <div class="checkbox-row">
                <input asp-for="Input.RememberMe" />
                <label asp-for="Input.RememberMe">Remember me</label>
            </div>

            <button type="submit" class="btn-login">Log In →</button>

            <div class="auth-card__links">
                <a id="forgot-password" asp-page="./ForgotPassword">Forgot password?</a>
                <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Create account</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
