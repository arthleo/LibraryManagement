@page
@model RegisterModel

@{
    ViewData["Title"] = "Register";
}
 <link rel="stylesheet" href="Registerindex.css">
<div class="register-page" style="text-align:center">

    <!-- Left Side -->
    <div class="register-left"  style="text-align:center">

        <h1 style="text-align:center">📚 Join Our Library</h1>

        <p style="text-align:center">
            Create your account and start
            exploring books online anytime.
        </p>

      
    </div>

    <!-- Right Side -->
    <div class="register-right" style="text-align:center">

        <div class="register-card" style="text-align:center">

            <h2 style="text-align:center">Create Account </h2>

            <p class="register-text" style="text-align:center">
                Register to continue
            </p>

            <form id="registerForm"
                  asp-route-returnUrl="@Model.ReturnUrl"
                  method="post" style="text-align:center">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger" style="text-align:center">
                </div>

                <!-- Email -->
                <div class="input-group" style="text-align:center">

                    <label style="text-align:center"> Email</label>

                    <input asp-for="Input.Email"
                           class="form-control"
                           placeholder="Enter your email" />

                    <span asp-validation-for="Input.Email"
                          class="text-danger">
                    </span>

                </div>

                <!-- Password -->
                <div class="input-group" style="text-align:center">

                    <label style="text-align:center"> Password</label>

                    <input asp-for="Input.Password"
                           class="form-control"
                           placeholder="Create password" />

                    <span asp-validation-for="Input.Password"
                          class="text-danger">
                    </span>

                </div>

                <!-- Confirm Password -->
                <div class="input-group" style="text-align:center">

                    <label style="text-align:center">Confirm Password</label>

                    <input asp-for="Input.ConfirmPassword"
                           class="form-control"
                           placeholder="Confirm password" />

                    <span asp-validation-for="Input.ConfirmPassword"
                          class="text-danger">
                    </span>

                </div>

                <!-- Register Button -->
                <button id="registerSubmit"
                        type="submit"
                        class="register-btn" style="text-align:center">

                    Create Account

                </button>

                <!-- Links -->
                <div class="register-links" style="text-align:center">

                    <a asp-page="./Login" style="text-align:center">
                        Already have an account? 
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
