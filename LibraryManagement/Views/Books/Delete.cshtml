@model LibraryManagement.Models.Book

@{
    ViewData["Title"] = "Delete Book";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/booksdelete.css"
          asp-append-version="true" />
}

<div class="book-page">
    <div class="book-card">

        <p class="book-subtitle">LIBRARY MANAGEMENT SYSTEM</p>
        <h1>Delete Book</h1>
        <p class="book-text">
            Are you sure you want to delete this book?
        </p>

        <div class="details-section">

            <div class="detail-row">
                <span class="detail-label">Book Title</span>
                <span class="detail-value">@Model.Title</span>
            </div>

            <div class="detail-row">
                <span class="detail-label">Author</span>
                <span class="detail-value">@Model.Author</span>
            </div>

            <div class="detail-row">
                <span class="detail-label">Genre</span>
                <span class="detail-value">@Model.Genre</span>
            </div>

            <div class="detail-row">
                <span class="detail-label">ISBN</span>
                <span class="detail-value">@Model.ISBN</span>
            </div>

            <div class="detail-row">
                <span class="detail-label">Summary</span>
                <span class="detail-value">@Model.Summary</span>
            </div>

            <div class="detail-row">
                <span class="detail-label">Availability</span>
                <span class="detail-value">
                    @(Model.IsAvailable ? "Available" : "Not Available")
                </span>
            </div>

            <div class="detail-row">
                <span class="detail-label">Library</span>
                <span class="detail-value">@Model.Library?.Name</span>
            </div>

            @if (!string.IsNullOrEmpty(Model.CoverImagePath))
            {
                <div class="detail-row">
                    <span class="detail-label">Cover Image</span>
                    <span class="detail-value">
                        <img src="@Model.CoverImagePath"
                             alt="Book Cover"
                             class="current-cover" />
                    </span>
                </div>
            }
        </div>

        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="Id" />

            <div class="button-group">
                <button type="submit" class="delete-btn">
                    Delete Book
                </button>

                <a asp-action="Index" class="cancel-btn">
                    Cancel
                </a>
            </div>
        </form>

    </div>
</div>