@model LibraryManagement.Models.Book

@{
    ViewData["Title"] = "Edit Book";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/bookedit.css"
          asp-append-version="true" />
}

<div class="book-page">
    <div class="book-card">

        <p class="book-subtitle">LIBRARY MANAGEMENT SYSTEM</p>
        <h1>Edit Book</h1>
        <p class="book-text">
            Update the book details below.
        </p>

        <form method="post"
              action="/Books/Edit/@Model.Id"
              enctype="multipart/form-data">

            @Html.AntiForgeryToken()

            <input type="hidden" name="Id" value="@Model.Id" />
            <input type="hidden"
                   name="CoverImagePath"
                   value="@Model.CoverImagePath" />

            <!-- Book Titles -->
            <div class="form-group">
                <label class="form-label">Book Title *</label>
                <input type="text"
                       name="Title"
                       class="form-control"
                       value="@Model.Title"
                       required />
            </div>

            <!-- Author -->
            <div class="form-group">
                <label class="form-label">Author *</label>
                <input type="text"
                       name="Author"
                       class="form-control"
                       value="@Model.Author"
                       required />
            </div>

            <!-- Genre -->
            <div class="form-group">
                <label class="form-label">Genre *</label>
                <input type="text"
                       name="Genre"
                       class="form-control"
                       value="@Model.Genre"
                       required />
            </div>

            <!-- ISBN -->
            <div class="form-group">
                <label class="form-label">ISBN Number *</label>
                <input type="text"
                       name="ISBN"
                       class="form-control"
                       value="@Model.ISBN"
                       required />
            </div>

            <!-- Summary -->
            <div class="form-group">
                <label class="form-label">Summary</label>
                <textarea name="Summary"
                          class="form-control"
                          rows="4">@Model.Summary</textarea>
            </div>

            <!-- Cover Image -->
            <div class="form-group">
                <label class="form-label">Upload New Cover Image</label>
                <input type="file"
                       name="CoverImageFile"
                       class="form-control"
                       accept="image/*" />

                @if (!string.IsNullOrEmpty(Model.CoverImagePath))
                {
                    <div class="mt-3 text-center">
                        <img src="@Model.CoverImagePath"
                             alt="Book Cover"
                             class="book-cover-preview" />
                    </div>
                }
            </div>

            <!-- Library ID -->
            <div class="form-group">
                <label class="form-label">Library ID *</label>
                <input type="number"
                       name="LibraryId"
                       class="form-control"
                       value="@Model.LibraryId"
                       required />
            </div>

            <!-- Availability -->
            <div class="checkbox-group">
                <input type="checkbox"
                       name="IsAvailable"
                       value="true"
                       id="isAvailable"
                       @(Model.IsAvailable ? "checked" : "") />
                <label for="isAvailable">Available</label>
            </div>

            <!-- Buttons -->
            <div class="button-group">
                <button type="submit" class="submit-btn">
                    Save Changes
                </button>

                <a href="/Books" class="back-link">
                    Cancel
                </a>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}