@{
    ViewData["Title"] = "Home Page";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/home.css"
          asp-append-version="true" />
}

<div class="home-page">

    <!-- Hero Section -->
    <div class="home-card hero-card">
        <p class="home-subtitle">LIBRARY MANAGEMENT SYSTEM</p>
        <h1>Welcome to Library Management System 📚</h1>
        <p class="home-text">
            This system allows users to browse, manage, and borrow books online.
        </p>
    </div>

    <!-- Group Members -->
    <div class="home-card">
        <h2>Group Members</h2>

        <table class="custom-table">
            <thead>
                <tr>
                    <th>Student ID</th>
                    <th>Last Name</th>
                    <th>First Name</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>20032259</td>
                    <td>Shakya</td>
                    <td>Namuna</td>
                </tr>
                <tr>
                    <td>20034635</td>
                    <td>Lesmana</td>
                    <td>Arthur</td>
                </tr>
                <tr>
                    <td>20032670</td>
                    <td>Rajput</td>
                    <td>Suhani</td>
                </tr>
                <tr>
                    <td>20032573</td>
                    <td>Bhandari</td>
                    <td>Kishore</td>
                </tr>
            </tbody>
        </table>
    </div>

    <!-- Library Summary -->
    <div class="home-card">
        <h2>📊 Library Summary</h2>

        <div class="summary-container">
            <div class="summary-box">
                <h3>Total Books</h3>
                <p>6</p>
            </div>

            <div class="summary-box">
                <h3>Available</h3>
                <p>5</p>
            </div>

            <div class="summary-box">
                <h3>Borrowed</h3>
                <p>1</p>
            </div>
        </div>
    </div>

    <!-- New Arrivals -->
    <div class="home-card">
        <h2>🆕 New Arrivals</h2>

        <div class="book-container">
            <div class="book-card">
                <img src="~/images/greatgatsby.jpg" asp-append-version="true" alt="The Great Gatsby" />
                <h3>The Great Gatsby</h3>
                <p>F. Scott Fitzgerald</p>
            </div>

            <div class="book-card">
                <img src="~/images/harrypotter.jpg" asp-append-version="true" alt="Harry Potter" />
                <h3>Harry Potter</h3>
                <p>J.K. Rowling</p>
            </div>

            <div class="book-card">
                <img src="~/images/junglebook.jpg" asp-append-version="true" alt="The Jungle Book" />
                <h3>The Jungle Book</h3>
                <p>Rudyard Kipling</p>
            </div>
        </div>
    </div>

    <!-- Most Borrowed Books -->
    <div class="home-card">
        <h2>🔥 Most Borrowed Books</h2>

        <div class="book-container">
            <div class="book-card">
                <img src="~/images/harrypotter.jpg" asp-append-version="true" alt="Harry Potter" />
                <h3>Harry Potter</h3>
                <p>Borrowed 25 times</p>
            </div>

            <div class="book-card">
                <img src="~/images/greatgatsby.jpg" asp-append-version="true" alt="The Great Gatsby" />
                <h3>The Great Gatsby</h3>
                <p>Borrowed 18 times</p>
            </div>
        </div>
    </div>

    <!-- Recommended Books -->
    <div class="home-card">
        <h2>⭐ Recommended Books</h2>

        <div class="book-container">
            <div class="book-card">
                <img src="~/images/junglebook.jpg" asp-append-version="true" alt="The Jungle Book" />
                <h3>The Jungle Book</h3>
                <p>Highly rated by readers</p>
            </div>

            <div class="book-card">
                <img src="~/images/greatgatsby.jpg" asp-append-version="true" alt="The Great Gatsby" />
                <h3>The Great Gatsby</h3>
                <p>Recommended classic novel</p>
            </div>
        </div>
    </div>

    <!-- Currently Available Books -->
    <div class="home-card">
        <h2>✅ Currently Available Books</h2>

        <div class="book-container">
            <div class="book-card">
                <img src="~/images/harrypotter.jpg" asp-append-version="true" alt="Harry Potter" />
                <h3>Harry Potter</h3>
                <p>Available Now</p>
            </div>

            <div class="book-card">
                <img src="~/images/junglebook.jpg" asp-append-version="true" alt="The Jungle Book" />
                <h3>The Jungle Book</h3>
                <p>Available Now</p>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <footer class="home-footer">
        <p>© 2026 KOI Library Management System</p>
    </footer>

</div>