@model IEnumerable<LibraryManagement.Models.Book>

@{
    ViewData["Title"] = "Home Page";

    // Books with uploaded images
    var booksWithImages = Model?
        .Where(b => !string.IsNullOrEmpty(b.CoverImagePath))
        .ToList() ?? new List<LibraryManagement.Models.Book>();

    // New Arrivals (latest 6 books)
    var newArrivals = booksWithImages
        .OrderByDescending(b => b.Id)
        .Take(6)
        .ToList();

    // Most Borrowed Books (sample: first 4 books)
    var mostBorrowed = booksWithImages
        .Take(4)
        .ToList();

    // Recommended zBooks (sample: first 4 books)
    var recommended = booksWithImages
        .Take(4)
        .ToList();

    // Currently Available Books
    var availableBooks = booksWithImages
        .Where(b => b.IsAvailable)
        .Take(6)
        .ToList();
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/home.css"
          asp-append-version="true" />
}

<div class="home-page">

    <!-- Hero Section -->
    <div class="home-card hero-card">
        <p class="home-subtitle">LIBRARY MANAGEMENT SYSTEM</p>
        <h1>Welcome to Library Management System 📚</h1>
        <p class="home-text">
            A user-friendly system for librarians and members to browse,
            borrow, and manage books online.
        </p>
    </div>

    <!-- Group Members -->
    <div class="home-card">
        <h2>Group Members</h2>

        <table class="custom-table">
            <thead>
                <tr>
                    <th>Student ID</th>
                    <th>Last Name</th>
                    <th>First Name</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>20032259</td>
                    <td>Shakya</td>
                    <td>Namuna</td>
                </tr>
                <tr>
                    <td>20034635</td>
                    <td>Lesmana</td>
                    <td>Arthur</td>
                </tr>
                <tr>
                    <td>20032670</td>
                    <td>Rajput</td>
                    <td>Suhani</td>
                </tr>
                <tr>
                    <td>20032573</td>
                    <td>Bhandari</td>
                    <td>Kishore</td>
                </tr>
            </tbody>
        </table>
    </div>

    <!-- Library Summaryss -->
    <div class="home-card">
        <h2>📊 Library Summary</h2>

        <div class="summary-container">
            <div class="summary-box">
                <h3>Total Books</h3>
                <p>@Model.Count()</p>
            </div>

            <div class="summary-box">
                <h3>Available</h3>
                <p>@Model.Count(b => b.IsAvailable)</p>
            </div>

            <div class="summary-box">
                <h3>Borrowed</h3>
                <p>@Model.Count(b => !b.IsAvailable)</p>
            </div>
        </div>
    </div>

    <!-- New Arrivals -->
    <div class="home-card">
        <h2>🆕 New Arrivals</h2>
        <p class="section-description">
            Recently added books in the library.
        </p>

        @if (newArrivals.Any())
        {
            <div class="book-container">
                @foreach (var book in newArrivals)
                {
                    <div class="book-card">
                        <img src="@book.CoverImagePath"
                             alt="@book.Title" />

                        <h3>@book.Title</h3>
                        <p>@book.Author</p>
                        <span class="book-tag">New</span>
                    </div>
                }
            </div>
        }
        else
        {
            <p class="empty-message">No new arrivals available.</p>
        }
    </div>

    <!-- Most Borrowed Books -->
    <div class="home-card">
        <h2>🔥 Most Borrowed Books</h2>
        <p class="section-description">
            Popular books frequently borrowed by members.
        </p>

        @if (mostBorrowed.Any())
        {
            <div class="book-container">
                @foreach (var book in mostBorrowed)
                {
                    <div class="book-card">
                        <img src="@book.CoverImagePath"
                             alt="@book.Title" />

                        <h3>@book.Title</h3>
                        <p>@book.Author</p>
                        <span class="book-tag popular">Popular</span>
                    </div>
                }
            </div>
        }
        else
        {
            <p class="empty-message">No borrowing data available.</p>
        }
    </div>

    <!-- Recommended Books -->
    <div class="home-card">
        <h2>⭐ Recommended Books</h2>
        <p class="section-description">
            Books recommended for readers.
        </p>

        @if (recommended.Any())
        {
            <div class="book-container">
                @foreach (var book in recommended)
                {
                    <div class="book-card">
                        <img src="@book.CoverImagePath"
                             alt="@book.Title" />

                        <h3>@book.Title</h3>
                        <p>@book.Author</p>
                        <span class="book-tag recommended">Recommended</span>
                    </div>
                }
            </div>
        }
        else
        {
            <p class="empty-message">No recommendations available.</p>
        }
    </div>

    <!-- Currently Available Books -->
    <div class="home-card">
        <h2>✅ Currently Available Books</h2>
        <p class="section-description">
            Books that are available for borrowing right now.
        </p>

        @if (availableBooks.Any())
        {
            <div class="book-container">
                @foreach (var book in availableBooks)
                {
                    <div class="book-card">
                        <img src="@book.CoverImagePath"
                             alt="@book.Title" />

                        <h3>@book.Title</h3>
                        <p>@book.Author</p>
                        <span class="book-tag available">Available</span>
                    </div>
                }
            </div>
        }
        else
        {
            <p class="empty-message">
                No books are currently available.
            </p>
        }
    </div>

    <!-- Footer -->
    <footer class="home-footer">
        <p>© 2026 KOI Library Management System</p>
    </footer>

</div>