@model LibraryManagement.Models.Reservation

@{
    ViewData["Title"] = "Reservation Details";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/reservation-details.css"
          asp-append-version="true" />
}

<div class="details-page">
    <div class="details-card">

        <p class="page-subtitle">RESERVATION MANAGEMENT</p>
        <h1>Reservation Details</h1>
        <p class="page-description">
            View complete information about this reservation.
        </p>

        <div class="details-grid">

            <div class="detail-item">
                <span class="detail-label">User ID</span>
                <span class="detail-value">@Model.UserId</span>
            </div>

            <div class="detail-item">
                <span class="detail-label">User</span>
                <span class="detail-value">
                    @(Model.User?.Email ?? "N/A")
                </span>
            </div>

            <div class="detail-item">
                <span class="detail-label">Book ID</span>
                <span class="detail-value">@Model.BookId</span>
            </div>

            <div class="detail-item">
                <span class="detail-label">Book</span>
                <span class="detail-value">
                    @(Model.Book?.Title ?? "N/A")
                </span>
            </div>

            <div class="detail-item">
                <span class="detail-label">Reserved At</span>
                <span class="detail-value">
                    @Model.ReservedAt.ToString("dd MMM yyyy hh:mm tt")
                </span>
            </div>

            <div class="detail-item">
                <span class="detail-label">Expiry Date</span>
                <span class="detail-value">
                    @Model.ExpiryDate.ToString("dd MMM yyyy hh:mm tt")
                </span>
            </div>

            <div class="detail-item">
                <span class="detail-label">Status</span>
                <span class="detail-value">@Model.Status</span>
            </div>

        </div>

        <div class="button-group">
            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="submit-btn">
                Edit Reservation
            </a>

            <a asp-action="Index"
               class="back-link">
                Back to List
            </a>
        </div>

    </div>
</div>