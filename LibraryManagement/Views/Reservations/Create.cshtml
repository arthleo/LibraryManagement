@model LibraryManagement.Models.Reservation

@{
    ViewData["Title"] = "Create Reservation";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/reservation-create.css"
          asp-append-version="true" />
}

<div class="form-page">
    <div class="form-card">

        <p class="page-subtitle">RESERVATION MANAGEMENT</p>
        <h1>Create Reservation</h1>
        <p class="page-description">
            Add a new reservation for a library member.
        </p>

        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly"
                 class="text-danger validation-summary"></div>

            <div class="mb-4">
                <label asp-for="UserId" class="form-label"></label>
                <input asp-for="UserId" class="form-control" />
                <span asp-validation-for="UserId"
                      class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="User" class="form-label"></label>
                <input asp-for="User" class="form-control" />
                <span asp-validation-for="User"
                      class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="BookId" class="form-label"></label>
                <input asp-for="BookId" class="form-control" />
                <span asp-validation-for="BookId"
                      class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Book" class="form-label"></label>
                <input asp-for="Book" class="form-control" />
                <span asp-validation-for="Book"
                      class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="ReservedAt" class="form-label"></label>
                <input asp-for="ReservedAt" class="form-control" />
                <span asp-validation-for="ReservedAt"
                      class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="ExpiryDate" class="form-label"></label>
                <input asp-for="ExpiryDate" class="form-control" />
                <span asp-validation-for="ExpiryDate"
                      class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Status" class="form-label"></label>
                <input asp-for="Status" class="form-control" />
                <span asp-validation-for="Status"
                      class="text-danger small"></span>
            </div>

            <div class="button-group">
                <button type="submit" class="submit-btn">
                    Create Reservation
                </button>

                <a asp-action="Index" class="back-link">
                    Back to List
                </a>
            </div>
        </form>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}