@model IEnumerable<LibraryManagement.Models.Reservation>

@{
    ViewData["Title"] = "Reservations";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/reservationsindex.css"
          asp-append-version="true" />
}

<div class="reservation-page">
    <div class="reservation-card">

        <p class="page-subtitle">RESERVATION MANAGEMENT</p>

        <h1>Book Reservations</h1>

        <p class="page-description">
            View and manage all book reservations made by library members.
        </p>

        @if (TempData["Success"] != null)
        {
            <div class="success-alert">
                @TempData["Success"]
            </div>
        }

        <div class="table-responsive">
            <table class="reservation-table">
                <thead>
                    <tr>
                        <th>Book</th>
                        <th>Member</th>
                        <th>Reserved At</th>
                        <th>Expiry Date</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@(item.Book?.Title ?? "Unknown Book")</td>
                                <td>@(item.User?.Email ?? "Unknown User")</td>
                                <td>@item.ReservedAt.ToString("dd MMM yyyy")</td>
                                <td>@item.ExpiryDate.ToString("dd MMM yyyy")</td>

                                <td>
                                    @if (item.Status == "Reserved")
                                    {
                                        <span class="status-badge reserved">
                                            Reserved
                                        </span>
                                    }
                                    else if (item.Status == "Completed")
                                    {
                                        <span class="status-badge completed">
                                            Completed
                                        </span>
                                    }
                                    else if (item.Status == "Cancelled")
                                    {
                                        <span class="status-badge cancelled">
                                            Cancelled
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-badge other">
                                            @item.Status
                                        </span>
                                    }
                                </td>

                                <td>
                                    @if (item.Status == "Reserved")
                                    {
                                        <div class="action-buttons">

                                            <form asp-action="Complete"
                                                  method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden"
                                                       name="id"
                                                       value="@item.Id" />
                                                <button type="submit"
                                                        class="action-btn complete-btn">
                                                    Complete
                                                </button>
                                            </form>

                                            <form asp-action="Cancel"
                                                  method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden"
                                                       name="id"
                                                       value="@item.Id" />
                                                <button type="submit"
                                                        class="action-btn cancel-btn">
                                                    Cancel
                                                </button>
                                            </form>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="no-action">
                                            No action
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="empty-message">
                                No reservations found.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

    </div>
</div>