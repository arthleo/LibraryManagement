@model LibraryManagement.Models.Reservation

@{
    ViewData["Title"] = "Edit Reservation";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/reservation-edit.css"
          asp-append-version="true" />
}

<div class="form-page">
    <div class="form-card">

        <p class="page-subtitle">RESERVATION MANAGEMENT</p>
        <h1>Edit Reservation</h1>
        <p class="page-description">
            Update reservation details and save the changes.
        </p>

        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

            <input type="hidden" asp-for="Id" />

            <!-- User ID -->
            <div class="mb-3">
                <label asp-for="UserId" class="form-label"></label>
                <input asp-for="UserId" class="form-control" />
                <span asp-validation-for="UserId" class="text-danger small"></span>
            </div>

            <!-- Book ID -->
            <div class="mb-3">
                <label asp-for="BookId" class="form-label"></label>
                <input asp-for="BookId" class="form-control" />
                <span asp-validation-for="BookId" class="text-danger small"></span>
            </div>

            <!-- Reserved At -->
            <div class="mb-3">
                <label asp-for="ReservedAt" class="form-label"></label>
                <input asp-for="ReservedAt" class="form-control" type="datetime-local" />
                <span asp-validation-for="ReservedAt" class="text-danger small"></span>
            </div>

            <!-- Expiry Date -->
            <div class="mb-3">
                <label asp-for="ExpiryDate" class="form-label"></label>
                <input asp-for="ExpiryDate" class="form-control" type="datetime-local" />
                <span asp-validation-for="ExpiryDate" class="text-danger small"></span>
            </div>

            <!-- Status -->
            <div class="mb-4">
                <label asp-for="Status" class="form-label"></label>
                <input asp-for="Status" class="form-control" />
                <span asp-validation-for="Status" class="text-danger small"></span>
            </div>

            <!-- Buttons -->
            <div class="button-group">
                <button type="submit" class="submit-btn">
                    Save Changes
                </button>

                <a asp-action="Index" class="back-link">
                    Back to List
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}