@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Library Management</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- Custom CSS -->
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>

<body>

    <!-- Navbar -->
    <nav class="navbar">
        <!-- Logo (goes to Home page) -->
        <div class="logo">
            <a asp-controller="Home"
               asp-action="Index"
               style="color:white; text-decoration:none;">
                📚 Library Management
            </a>
        </div>

        <ul class="nav-links">

            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                <!-- Home — same for everyone -->
                <li>
                    <a asp-controller="Home" asp-action="Index">
                        Home
                    </a>
                </li>

                <!-- Library — same for everyone -->
                <li>
                    <a asp-controller="Libraries" asp-action="Index">
                        Library
                    </a>
                </li>

                <!-- Dashboard — Admin → /Admin, Member → /Member -->
                <li>
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-controller="Admin" asp-action="Index">
                            Dashboard
                        </a>
                    }
                    else
                    {
                        <a asp-controller="Member" asp-action="Index">
                            Dashboard
                        </a>
                    }
                </li>

                <!-- Books — same page, but Admin sees edit/delete, Member sees read-only -->
                <li>
                    <a asp-controller="Books" asp-action="Index">
                        Books
                    </a>
                </li>

                <!-- Borrow — Admin → all transactions, Member → browse & borrow -->
                <li>
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-controller="Admin" asp-action="Transactions">
                            Borrow
                        </a>
                    }
                    else
                    {
                        <a asp-controller="Member" asp-action="Browse">
                            Borrow
                        </a>
                    }
                </li>

                <!-- Feedback — same for everyone -->
                <li>
                    <a asp-controller="Feedbacks" asp-action="Index">
                        Feedback
                    </a>
                </li>

                <!-- Users — Admin only -->
                @if (User.IsInRole("Admin"))
                {
                    <li>
                        <a asp-controller="Admin" asp-action="Users">
                            Users
                        </a>
                    </li>
                }

                <!-- Logout -->
                <li>
                    <form method="post"
                          asp-area="Identity"
                          asp-page="/Account/Logout"
                          asp-route-returnUrl="/"
                          style="display:inline;">

                        @Html.AntiForgeryToken()

                        <button type="submit" class="logout-btn">
                            Logout
                        </button>
                    </form>
                </li>
            }
            else
            {
                <!-- Login -->
                <li>
                    <a href="/Identity/Account/Login">
                        Login
                    </a>
                </li>

                <!-- Register -->
                <li>
                    <a href="/Identity/Account/Register">
                        Register
                    </a>
                </li>
            }

        </ul>
    </nav>

    <!-- Main Content -->
    <div class="main-container">
        @RenderBody()
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
