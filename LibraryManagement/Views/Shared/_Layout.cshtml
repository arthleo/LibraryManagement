        <div class="logo">📚 Library</div>

        <ul class="nav-links">
            <li><a href="/">Home</a></li>
            <li><a href="/Books">Books</a></li>
            <li><a href="/Dashboard">Dashboard</a></li>
            <li><a href="/Identity/Account/Login">Login</a></li>
            <li><a href="/Identity/Account/Register">Register</a></li>
        </ul>
    </nav>

    <!-- Page Content -->
    <div class="container">
