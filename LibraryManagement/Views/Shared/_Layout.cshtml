@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Library Management</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <!-- Site CSS -->
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)

    <style>
            .navbar {
                background: #c0392b;
                padding: 1rem 2rem;
                display: flex;
                justify-content: space-between;
                align-items: center;
                flex-wrap: wrap;
            }

            .logo {
                font-size: 2rem;
                font-weight: 800;
            }

            .nav-links {
                list-style: none;
                display: flex;
                align-items: center;
                gap: 1.2rem;
                margin: 0;
                padding: 0;
                flex-wrap: wrap;
            }

                /* NORMAL NAV LINKS */
                .nav-links > li > a,
                .nav-link.dropdown-toggle {
                    color: white !important;
                    text-decoration: none;
                    font-weight: 700;
                    font-size: 1rem;
                }

                    .nav-links > li > a:hover,
                    .nav-link.dropdown-toggle:hover {
                        opacity: 0.85;
                    }

            /* DROPDOWN */
            .dropdown-menu {
                background: white;
                border-radius: 12px;
                border: 2px solid #111;
                padding: 0.5rem;
                min-width: 230px;
                z-index: 9999;
                box-shadow: 4px 4px 0 #111;
            }

                .dropdown-menu .dropdown-item {
                    color: #111 !important;
                    background: white !important;
                    font-weight: 700;
                    padding: 0.7rem 1rem;
                    border-radius: 8px;
                    display: block;
                    transition: 0.2s ease;
                }

                    .dropdown-menu .dropdown-item:hover {
                        background: #f5f0e8 !important;
                        color: #c0392b !important;
                    }

            /* LOGOUT BUTTON */
            .logout-btn {
                background: white;
                color: #c0392b;
                border: none;
                padding: 0.6rem 1rem;
                border-radius: 10px;
                font-weight: 700;
            }

                .logout-btn:hover {
                    background: #f4f4f4;
                }

            /* MAIN CONTENT */
            .main-container {
                padding: 0;
            }

            /* MOBILE */
            @@media (max-width: 900px) {

                .navbar {
                    flex-direction: column;
                    align-items: flex-start;
                    gap: 1rem;
                }

                .nav-links {
                    width: 100%;
                }
            }
    </style>
</head>

<body>

    <!-- NAVBAR -->
    <nav class="navbar">

        <!-- LOGO -->
        <div class="logo">
            <a asp-controller="Home"
               asp-action="Index"
               style="color:white; text-decoration:none;">
                📚 Library Management
            </a>
        </div>

        <!-- NAVIGATION -->
        <ul class="nav-links">

            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                <!-- HOME -->
                <li>
                    <a asp-controller="Home"
                       asp-action="Index">
                        Home
                    </a>
                </li>

                <!-- LIBRARIES -->
                <li>
                    <a asp-controller="Libraries"
                       asp-action="Index">
                        Library
                    </a>
                </li>

                <!-- DASHBOARD -->
                @if (User.IsInRole("Admin"))
                {
                    <li>
                        <a asp-controller="Admin"
                           asp-action="Index">
                            Dashboard
                        </a>
                    </li>
                }

                <!-- BOOKS -->
                <li>
                    <a asp-controller="Books"
                       asp-action="Index">
                        Books
                    </a>
                </li>

                <!-- MEMBER / BORROW -->
                <li>
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-controller="BorrowingTransactions"
                           asp-action="Index">
                            Borrow
                        </a>
                    }
                    else
                    {
                        <a asp-controller="Member"
                           asp-action="Index">
                            Dashboard
                        </a>
                    }
                </li>

                <!-- MEMBER BROWSE -->
                @if (!User.IsInRole("Admin"))
                {
                    <li>
                        <a asp-controller="Member"
                           asp-action="Browse">
                            Browse Books
                        </a>
                    </li>
                }

                <!-- ADMIN DROPDOWN -->
                @if (User.IsInRole("Admin"))
                {
                    <li class="nav-item dropdown">

                        <a class="nav-link dropdown-toggle"
                           href="#"
                           role="button"
                           data-bs-toggle="dropdown"
                           aria-expanded="false">

                            More
                        </a>

                        <ul class="dropdown-menu">

                            <li>
                                <a class="dropdown-item"
                                   asp-controller="Reservations"
                                   asp-action="Index">
                                    Reservations
                                </a>
                            </li>

                            <li>
                                <a class="dropdown-item"
                                   asp-controller="BorrowingConfigs"
                                   asp-action="Index">
                                    Borrow Config
                                </a>
                            </li>

                            <li>
                                <a class="dropdown-item"
                                   asp-controller="Feedbacks"
                                   asp-action="Index">
                                    Feedback
                                </a>
                            </li>

                            <li>
                                <a class="dropdown-item"
                                   asp-controller="Admin"
                                   asp-action="Users">
                                    Users
                                </a>
                            </li>

                            <li>
                                <a class="dropdown-item"
                                   asp-controller="Admin"
                                   asp-action="Transactions">
                                    Transactions
                                </a>
                            </li>

                        </ul>
                    </li>
                }
                else
                {
                    <!-- MEMBER FEEDBACK -->
                    <li>
                        <a asp-controller="Feedbacks"
                           asp-action="Index">
                            Feedback
                        </a>
                    </li>
                }

                <!-- LOGOUT -->
                <li>
                    <form method="post"
                          asp-area="Identity"
                          asp-page="/Account/Logout"
                          asp-route-returnUrl="/"
                          style="display:inline;">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="logout-btn">
                            Logout
                        </button>
                    </form>
                </li>
            }
            else
            {
                <!-- LOGIN -->
                <li>
                    <a href="/Identity/Account/Login">
                        Login
                    </a>
                </li>

                <!-- REGISTER -->
                <li>
                    <a href="/Identity/Account/Register">
                        Register
                    </a>
                </li>
            }

        </ul>
    </nav>

    <!-- MAIN CONTENT -->
    <div class="main-container">
        @RenderBody()
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>