@model LibraryManagement.Models.Feedback

@{
    ViewData["Title"] = "Delete Feedback";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/feedbackdelete.css"
          asp-append-version="true" />
}

<div class="delete-page">
    <div class="delete-card">

        <p class="delete-subtitle">FEEDBACK MANAGEMENT</p>
        <h1>Delete Feedback</h1>
        <p class="delete-text">
            Are you sure you want to delete this feedback? This action cannot be undone.
        </p>

        <div class="details-box">
            <div class="detail-row">
                <span class="detail-label">User</span>
                <span class="detail-value">@Model.User?.Email</span>
            </div>

            <div class="detail-row">
                <span class="detail-label">Book</span>
                <span class="detail-value">@Model.Book?.Title</span>
            </div>

            <div class="detail-row">
                <span class="detail-label">Rating</span>
                <span class="detail-value">⭐ @Model.Rating / 5</span>
            </div>

            <div class="detail-row">
                <span class="detail-label">Comment</span>
                <span class="detail-value">@Model.Comment</span>
            </div>

            <div class="detail-row">
                <span class="detail-label">Submitted At</span>
                <span class="detail-value">
                    @Model.SubmittedAt.ToString("dd MMM yyyy")
                </span>
            </div>
        </div>

        <form asp-action="Delete" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />

            <div class="button-group">
                <button type="submit" class="delete-btn">
                    Delete Feedback
                </button>

                <a asp-action="Index" class="back-link">
                    Back to List
                </a>
            </div>
        </form>
    </div>
</div>