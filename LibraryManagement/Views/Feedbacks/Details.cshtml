@model LibraryManagement.Models.Feedback

@{
    ViewData["Title"] = "Feedback Details";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/feedbackdetails.css"
          asp-append-version="true" />
}

<div class="details-page">
    <div class="details-card">

        <p class="details-subtitle">FEEDBACK MANAGEMENT</p>
        <h1>Feedback Details</h1>
        <p class="details-text">
            View detailed information about the selected feedback.
        </p>

        <div class="details-box">
            <div class="detail-row">
                <span class="detail-label">User</span>
                <span class="detail-value">@Model.User?.Email</span>
            </div>

            <div class="detail-row">
                <span class="detail-label">Book</span>
                <span class="detail-value">@Model.Book?.Title</span>
            </div>

            <div class="detail-row">
                <span class="detail-label">Rating</span>
                <span class="detail-value">⭐ @Model.Rating / 5</span>
            </div>

            <div class="detail-row">
                <span class="detail-label">Comment</span>
                <span class="detail-value">@Model.Comment</span>
            </div>

            <div class="detail-row">
                <span class="detail-label">Submitted At</span>
                <span class="detail-value">
                    @Model.SubmittedAt.ToString("dd MMM yyyy")
                </span>
            </div>
        </div>

        <div class="button-group">
            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="edit-btn">
                Edit Feedback
            </a>

            <a asp-action="Index"
               class="back-link">
                Back to List
            </a>
        </div>
    </div>
</div>