@model IEnumerable<LibraryManagement.Models.Feedback>

@{
    ViewData["Title"] = "Feedback List";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/feedbackindex.css"
          asp-append-version="true" />
}

<div class="feedback-page">
    <div class="feedback-card wide-card">

        <p class="feedback-subtitle">LIBRARY MANAGEMENT SYSTEM</p>
        <h1>Feedback List</h1>
        <p class="feedback-text">View all submitted feedback.</p>

        <div class="text-center mb-4">
            <a asp-action="Create" class="submit-btn text-decoration-none d-inline-block">
                + Create New Feedback
            </a>
        </div>
         <div class="table-responsive">
            <table class="table feedback-table">
                <thead>
                    <tr>
                        <th>User</th>
                        <th>Book</th>
                        <th>Rating</th>
                        <th>Comment</th>
                        <th>Date</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.User?.Email</td>
                            <td>@item.Book?.Title</td>
                            <td>@item.Rating</td>
                            <td>@item.Comment</td>
                            <td>@item.SubmittedAt.ToString("dd/MM/yyyy")</td>
                            <td>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="action-link">Edit</a>
                                <a asp-action="Details" asp-route-id="@item.Id" class="action-link">Details</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="action-link delete-link">Delete</a>
                            </td>
                        </tr>
                         }
                </tbody>
            </table>
        </div>

        <div class="bottom-links">
            <a asp-controller="Home" asp-action="Dashboard">Back to Dashboard</a>
        </div>
    </div>
</div>