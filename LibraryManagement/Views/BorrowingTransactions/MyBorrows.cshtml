@model IEnumerable<LibraryManagement.Models.BorrowingTransaction>

@{
    ViewData["Title"] = "My Borrowed Books";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/myborrow.css"
          asp-append-version="true" />
}

<div class="borrow-page">
    <div class="borrow-card">

        <p class="borrow-subtitle">LIBRARY MANAGEMENT SYSTEM</p>
        <h1>My Borrowed Books</h1>
        <p class="borrow-text">
            View your borrowed books, due dates, fines, and renewal options.
        </p>

        @if (TempData["Success"] != null)
        {
            <div class="alert-success-box">
                @TempData["Success"]
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert-error-box">
                @TempData["Error"]
            </div>
        }

        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="borrow-table">
                    <thead>
                        <tr>
                            <th>Book Title</th>
                            <th>Borrowed Date</th>
                            <th>Due Date</th>
                            <th>Status</th>
                            <th>Fine ($)</th>
                            <th>Renewals</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Book?.Title</td>
                                <td>@item.BorrowedAt.ToString("dd/MM/yyyy")</td>

                                <td>
                                    @item.DueDate.ToString("dd/MM/yyyy")

                                    @if (item.DueDate < DateTime.Now &&
                                         item.Status == "Borrowed")
                                    {
                                        <span class="status-badge overdue">
                                            Overdue
                                        </span>
                                    }
                                </td>

                                <td>
                                    @if (item.Status == "Borrowed")
                                    {
                                        <span class="status-badge borrowed">
                                            Borrowed
                                        </span>
                                    }
                                    else if (item.Status == "Returned")
                                    {
                                        <span class="status-badge returned">
                                            Returned
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-badge pending">
                                            @item.Status
                                        </span>
                                    }
                                </td>

                                <td>$@item.FineAmount.ToString("0.00")</td>

                                <td>@item.RenewalsUsed / 2</td>

                                <td class="action-buttons">
                                    @if (item.Status == "Borrowed")
                                    {
                                        <form method="post"
                                              action="/BorrowingTransactions/ReturnBook/@item.Id">
                                            @Html.AntiForgeryToken()
                                            <button type="submit"
                                                    class="action-btn return-btn">
                                                Return
                                            </button>
                                        </form>

                                        @if (item.RenewalsUsed < 2)
                                        {
                                            <form method="post"
                                                  action="/BorrowingTransactions/RenewBook/@item.Id">
                                                @Html.AntiForgeryToken()
                                                <button type="submit"
                                                        class="action-btn renew-btn">
                                                    Renew
                                                </button>
                                            </form>
                                        }
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-message">
                No borrowed books found.
            </div>
        }

        <div class="button-group">
            <a href="/Books" class="browse-btn">
                Browse Books
            </a>
        </div>

    </div>
</div>