@model IEnumerable<LibraryManagement.Models.BorrowingTransaction>

@{
    ViewData["Title"] = "Borrowing Report";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/borrowingreport.css"
          asp-append-version="true" />
}

<div class="report-page">
    <div class="report-card">

        <p class="report-subtitle">LIBRARY MANAGEMENT SYSTEM</p>
        <h1>Borrowing Report</h1>
        <p class="report-text">
            View borrowing statistics, overdue books, and total fines.
        </p>

        <!-- Summary Cards -->
        <div class="summary-grid">
            <div class="summary-box">
                <h3>@Model.Count()</h3>
                <p>Total Transactions</p>
            </div>

            <div class="summary-box">
                <h3>@Model.Count(b => b.Status == "Borrowed")</h3>
                <p>Currently Borrowed</p>
            </div>

            <div class="summary-box">
                <h3>
                    @Model.Count(b => b.DueDate < DateTime.Now &&
                                      b.Status == "Borrowed")
                </h3>
                <p>Overdue Books</p>
            </div>

            <div class="summary-box">
                <h3>$@Model.Sum(b => b.FineAmount).ToString("0.00")</h3>
                <p>Total Fines</p>
            </div>
        </div>

        <!-- Transactions Table -->
        <div class="table-responsive">
            <table class="report-table">
                <thead>
                    <tr>
                        <th>Book</th>
                        <th>Member</th>
                        <th>Borrowed Date</th>
                        <th>Due Date</th>
                        <th>Status</th>
                        <th>Fine ($)</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Book?.Title</td>
                                <td>@item.User?.Email</td>
                                <td>@item.BorrowedAt.ToString("dd/MM/yyyy")</td>
                                <td>@item.DueDate.ToString("dd/MM/yyyy")</td>

                                <td>
                                    @if (item.Status == "Borrowed" &&
                                         item.DueDate < DateTime.Now)
                                    {
                                        <span class="status-badge overdue">
                                            Overdue
                                        </span>
                                    }
                                    else if (item.Status == "Borrowed")
                                    {
                                        <span class="status-badge borrowed">
                                            Borrowed
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-badge returned">
                                            Returned
                                        </span>
                                    }
                                </td>

                                <td>
                                    $@item.FineAmount.ToString("0.00")
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="empty-message">
                                No borrowing records found.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Back Button -->
        <div class="button-group">
            <a href="/BorrowingTransactions"
               class="back-btn">
                Back to Transactions
            </a>
        </div>

    </div>
</div>