@model IEnumerable<LibraryManagement.Models.BorrowingTransaction>

@{
    ViewData["Title"] = "Overdue Books";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/overduebooks.css"
          asp-append-version="true" />
}

<div class="overdue-page">
    <div class="overdue-card">

        <p class="overdue-subtitle">LIBRARY MANAGEMENT SYSTEM</p>
        <h1>Overdue Books</h1>
        <p class="overdue-text">
            View all overdue books and manage outstanding fines.
        </p>

        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="overdue-table">
                    <thead>
                        <tr>
                            <th>Book Title</th>
                            <th>Member</th>
                            <th>Due Date</th>
                            <th>Days Overdue</th>
                            <th>Fine ($)</th>
                            <th>Fine Paid</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            int daysOverdue = (DateTime.Now - item.DueDate).Days;

                            <tr>
                                <td>@item.Book?.Title</td>
                                <td>@item.User?.Email</td>
                                <td>@item.DueDate.ToString("dd/MM/yyyy")</td>
                                <td>
                                    <span class="status-badge overdue">
                                        @daysOverdue days
                                    </span>
                                </td>
                                <td>$@item.FineAmount.ToString("0.00")</td>

                                <td>
                                    @if (item.FinePaid)
                                    {
                                        <span class="status-badge paid">
                                            Paid
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-badge unpaid">
                                            Unpaid
                                        </span>
                                    }
                                </td>

                                <td>
                                    @if (!item.FinePaid && item.FineAmount > 0)
                                    {
                                        <form method="post"
                                              action="/BorrowingTransactions/MarkFinePaid/@item.Id">
                                            @Html.AntiForgeryToken()
                                            <button type="submit"
                                                    class="action-btn paid-btn">
                                                Mark Fine Paid
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-message">
                No overdue books found.
            </div>
        }

        <div class="button-group">
            <a href="/BorrowingTransactions"
               class="back-btn">
                Back to All Transactions
            </a>
        </div>

    </div>
</div>