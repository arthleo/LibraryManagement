@model IEnumerable<LibraryManagement.Models.Library>

@{
    ViewData["Title"] = "Library List";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/libraryindex.css"
          asp-append-version="true" />
}

<div class="feedback-page">
    <div class="feedback-card wide-card">

        <p class="feedback-subtitle">LIBRARY MANAGEMENT SYSTEM</p>
        <h1>Library List</h1>

        <p class="feedback-text">
            View and manage all library branches and their details.
        </p>

        @if (User.IsInRole("Admin"))
        {
            <div class="text-center mb-4">
                <a asp-action="Create"
                   class="submit-btn text-decoration-none d-inline-block">
                    + Create New Library
                </a>
            </div>
        }

        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table feedback-table">

                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Location</th>
                            <th>Operating Hours</th>
                            <th>Contact Details</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Name</td>
                                <td>@item.Location</td>
                                <td>@item.OperatingHours</td>
                                <td>@item.ContactDetails</td>

                                <td>
                                    <a asp-action="Details"
                                       asp-route-id="@item.Id"
                                       class="action-link">
                                        Details
                                    </a>

                                    @if (User.IsInRole("Admin"))
                                    {
                                        <a asp-action="Edit"
                                           asp-route-id="@item.Id"
                                           class="action-link">
                                            Edit
                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@item.Id"
                                           class="action-link delete-link">
                                            Delete
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>
        }
        else
        {
            <p class="text-center mt-4">
                No library records found.
            </p>
        }

        <div class="bottom-links">
            <a asp-controller="Home"
               asp-action="Dashboard">
                Back to Dashboard
            </a>
        </div>

    </div>
</div>