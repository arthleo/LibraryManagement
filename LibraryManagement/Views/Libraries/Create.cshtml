@model LibraryManagement.Models.Library

@{
    ViewData["Title"] = "Create Library";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/librarycreate.css"
          asp-append-version="true" />
}

<div class="feedback-page">
    <div class="feedback-card">

        <p class="feedback-subtitle">LIBRARY MANAGEMENT SYSTEM</p>
        <h1>Create Library</h1>
        <p class="feedback-text">
            Enter the library details to add a new library.
        </p>

        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <!-- Library Name -->
            <div class="form-group-custom">
                <label asp-for="Name">Library Name *</label>
                <input asp-for="Name" class="form-input" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <!-- Locations -->
            <div class="form-group-custom">
                <label asp-for="Location">Location *</label>
                <input asp-for="Location" class="form-input" />
                <span asp-validation-for="Location" class="text-danger"></span>
            </div>

            <!-- Operating Hours -->
            <div class="form-group-custom">
                <label asp-for="OperatingHours">Operating Hours</label>
                <input asp-for="OperatingHours" class="form-input" />
                <span asp-validation-for="OperatingHours" class="text-danger"></span>
            </div>

            <!-- Contact Details -->
            <div class="form-group-custom">
                <label asp-for="ContactDetails">Contact Details</label>
                <input asp-for="ContactDetails" class="form-input" />
                <span asp-validation-for="ContactDetails" class="text-danger"></span>
            </div>

            <!-- Submit Button -->
            <button type="submit" class="submit-btn">
                Create Library →
            </button>

            <!-- Bottom Links -->
            <div class="bottom-links">
                <a asp-action="Index">Back to List</a>
                <a asp-controller="Home" asp-action="Dashboard">
                    Dashboard
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
