@model LibraryManagement.Models.Library

@{
    ViewData["Title"] = "Edit Library";
}

<style>
    .edit-page {
        min-height: 100vh;
        background: #f5f0e8;
        padding: 40px 20px;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .edit-card {
        width: 100%;
        max-width: 650px;
        background: white;
        border: 2px solid #111;
        box-shadow: 8px 8px 0 #111;
        padding: 35px;
    }

    .edit-title {
        font-size: 2rem;
        font-weight: 900;
        margin-bottom: 10px;
        color: #111;
    }

    .edit-subtitle {
        color: #666;
        margin-bottom: 30px;
    }

    .form-group {
        margin-bottom: 20px;
    }

    .control-label {
        font-weight: 700;
        margin-bottom: 8px;
        display: block;
        color: #111;
    }

    .form-control {
        border: 2px solid #111;
        border-radius: 10px;
        padding: 12px;
        box-shadow: 3px 3px 0 #111;
        font-size: 1rem;
    }

        .form-control:focus {
            border-color: #c0392b;
            box-shadow: 3px 3px 0 #c0392b;
        }

    .btn-save {
        background: #c0392b;
        color: white;
        border: none;
        padding: 12px 24px;
        font-weight: 700;
        border-radius: 10px;
        box-shadow: 3px 3px 0 #111;
        transition: 0.2s ease;
    }

        .btn-save:hover {
            background: #a93226;
            transform: translateY(-2px);
        }

    .back-link {
        display: inline-block;
        margin-top: 20px;
        text-decoration: none;
        font-weight: 700;
        color: #111;
    }

        .back-link:hover {
            color: #c0392b;
        }

    .text-danger {
        font-size: 0.9rem;
        margin-top: 5px;
        display: block;
    }
</style>

<div class="edit-page">

    <div class="edit-card">

        <h1 class="edit-title">Edit Library</h1>

        <p class="edit-subtitle">
            Update the library details below.
        </p>

        <form asp-action="Edit">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger">
            </div>

            <input type="hidden" asp-for="Id" />

            <div class="form-group">
                <label asp-for="Name"
                       class="control-label">
                </label>

                <input asp-for="Name"
                       class="form-control" />

                <span asp-validation-for="Name"
                      class="text-danger">
                </span>
            </div>

            <div class="form-group">
                <label asp-for="Location"
                       class="control-label">
                </label>

                <input asp-for="Location"
                       class="form-control" />

                <span asp-validation-for="Location"
                      class="text-danger">
                </span>
            </div>

            <div class="form-group">
                <label asp-for="OperatingHours"
                       class="control-label">
                </label>

                <input asp-for="OperatingHours"
                       class="form-control" />

                <span asp-validation-for="OperatingHours"
                      class="text-danger">
                </span>
            </div>

            <div class="form-group">
                <label asp-for="ContactDetails"
                       class="control-label">
                </label>

                <input asp-for="ContactDetails"
                       class="form-control" />

                <span asp-validation-for="ContactDetails"
                      class="text-danger">
                </span>
            </div>

            <div class="form-group">
                <input type="submit"
                       value="Save Changes"
                       class="btn-save" />
            </div>

        </form>

        <a asp-action="Index"
           class="back-link">
            ← Back to List
        </a>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}