@model LibraryManagement.Models.BorrowingConfig

@{
    ViewData["Title"] = "Edit Borrowing Configuration";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/borrowingconfigedit.css"
          asp-append-version="true" />
}

<div class="config-page">
    <div class="config-card">

        <p class="config-subtitle">LIBRARY MANAGEMENT SYSTEM</p>
        <h1>Edit Borrowing Configuration</h1>
        <p class="config-text">
            Update the borrowing settings for this library.
        </p>

        <form asp-action="Edit" method="post">
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

            <input type="hidden" asp-for="Id" />

            <div class="form-group">
                <label asp-for="LoanDurationDays"></label>
                <input asp-for="LoanDurationDays" class="form-control" />
                <span asp-validation-for="LoanDurationDays" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="RenewalLimit"></label>
                <input asp-for="RenewalLimit" class="form-control" />
                <span asp-validation-for="RenewalLimit" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="OverduePenaltyPerDay"></label>
                <input asp-for="OverduePenaltyPerDay" class="form-control" />
                <span asp-validation-for="OverduePenaltyPerDay" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="MaxBorrowableItems"></label>
                <input asp-for="MaxBorrowableItems" class="form-control" />
                <span asp-validation-for="MaxBorrowableItems" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="LibraryId"></label>
                <select asp-for="LibraryId"
                        class="form-control"
                        asp-items="ViewBag.LibraryId">
                </select>
                <span asp-validation-for="LibraryId" class="text-danger"></span>
            </div>

            <div class="button-group">
                <button type="submit" class="submit-btn">
                    Save Changes
                </button>

                <a asp-action="Index" class="cancel-btn">
                    Back to List
                </a>
            </div>
        </form>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}