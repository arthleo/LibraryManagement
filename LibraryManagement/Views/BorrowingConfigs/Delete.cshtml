@model LibraryManagement.Models.BorrowingConfig

@{
    ViewData["Title"] = "Delete Borrowing Configuration";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/borrowingconfigdelete.css"
          asp-append-version="true" />
}

<div class="config-page">
    <div class="config-card">

        <p class="config-subtitle">LIBRARY MANAGEMENT SYSTEM</p>
        <h1>Delete Borrowing Configuration</h1>
        <p class="config-text warning-text">
            Are you sure you want to delete this borrowing configuration?
        </p>

        <div class="details-section">

            <div class="detail-row">
                <span class="detail-label">Loan Duration (Days)</span>
                <span class="detail-value">@Model.LoanDurationDays</span>
            </div>

            <div class="detail-row">
                <span class="detail-label">Renewal Limit</span>
                <span class="detail-value">@Model.RenewalLimit</span>
            </div>

            <div class="detail-row">
                <span class="detail-label">Overdue Penalty Per Day</span>
                <span class="detail-value">@Model.OverduePenaltyPerDay</span>
            </div>

            <div class="detail-row">
                <span class="detail-label">Maximum Borrowable Items</span>
                <span class="detail-value">@Model.MaxBorrowableItems</span>
            </div>

            <div class="detail-row">
                <span class="detail-label">Library</span>
                <span class="detail-value">
                    @(Model.Library?.Name ?? "No Library")
                </span>
            </div>

        </div>

        <form asp-action="Delete">
            <input type="hidden" asp-for="Id" />

            <div class="button-group">
                <button type="submit" class="delete-btn">
                    Delete Configuration
                </button>

                <a asp-action="Index" class="cancel-btn">
                    Back to List
                </a>
            </div>
        </form>

    </div>
</div>