@model IEnumerable<LibraryManagement.Models.BorrowingConfig>

@{
    ViewData["Title"] = "Borrowing Parameters";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/borrowingconfigindex.css"
          asp-append-version="true" />
}

<div class="config-page">
    <div class="config-card">

        <p class="config-subtitle">LIBRARY MANAGEMENT SYSTEM</p>

        <div class="header-section">
            <div>
                <h1>Borrowing Parameters</h1>

                <p class="config-text">
                    Manage loan duration, overdue penalties, renewal limits,
                    and borrowing settings for libraries.
                </p>
            </div>

            <a asp-action="Create"
               class="create-btn">
                + Add Configuration
            </a>
        </div>

        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">

                <table class="config-table">

                    <thead>
                        <tr>
                            <th>Library</th>
                            <th>Loan Duration</th>
                            <th>Renewal Limit</th>
                            <th>Overdue Penalty</th>
                            <th>Max Borrowable</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>
                                    @(item.Library?.Name ?? "No Library")
                                </td>

                                <td>
                                    @item.LoanDurationDays days
                                </td>

                                <td>
                                    @item.RenewalLimit
                                </td>

                                <td>
                                    $@item.OverduePenaltyPerDay.ToString("0.00")
                                </td>

                                <td>
                                    @item.MaxBorrowableItems books
                                </td>

                                <td class="action-buttons">

                                    <a asp-action="Edit"
                                       asp-route-id="@item.Id"
                                       class="action-link edit-link">
                                        Edit
                                    </a>

                                    <a asp-action="Details"
                                       asp-route-id="@item.Id"
                                       class="action-link details-link">
                                        Details
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@item.Id"
                                       class="action-link delete-link">
                                        Delete
                                    </a>

                                </td>

                            </tr>
                        }
                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="empty-message">
                No borrowing configuration found.
            </div>
        }

    </div>
</div>