@model IEnumerable<LibraryManagement.Models.BorrowingConfig>

@{
    ViewData["Title"] = "Borrowing Parameters";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>⚙️ Borrowing Parameters</h2>

        <a asp-action="Create" class="btn btn-primary">
            + Add Config
        </a>
    </div>

    <p class="text-muted">
        Admin can configure loan duration, renewal limits, overdue penalties and maximum borrowable books.
    </p>

    <table class="table table-bordered table-hover">
        <thead class="table-dark">
            <tr>
                <th>Library</th>
                <th>Loan Duration</th>
                <th>Renewal Limit</th>
                <th>Overdue Penalty</th>
                <th>Max Borrowable Items</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td>@(item.Library?.Name ?? "No Library")</td>
                        <td>@item.LoanDurationDays days</td>
                        <td>@item.RenewalLimit</td>
                        <td>$@item.OverduePenaltyPerDay.ToString("0.00") per day</td>
                        <td>@item.MaxBorrowableItems books</td>
                        <td>
                            <a asp-action="Edit"
                               asp-route-id="@item.Id"
                               class="btn btn-sm btn-warning">
                                Edit
                            </a>

                            <a asp-action="Details"
                               asp-route-id="@item.Id"
                               class="btn btn-sm btn-info">
                                Details
                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@item.Id"
                               class="btn btn-sm btn-danger">
                                Delete
                            </a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6" class="text-center">
                        No borrowing configuration found.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>