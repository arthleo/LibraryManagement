@model LibraryManagement.Models.BorrowingConfig

@{
    ViewData["Title"] = "Create Borrowing Configuration";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/borrowingconfigcreate.css"
          asp-append-version="true" />
}

<div class="config-page">
    <div class="config-card">

        <p class="config-subtitle">LIBRARY MANAGEMENT SYSTEM</p>
        <h1>Create Borrowing Configuration</h1>
        <p class="config-text">
            Set the borrowing rules for your library.
        </p>

        <form asp-action="Create">

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <!-- Loan Duration -->
            <div class="form-group mb-3">
                <label asp-for="LoanDurationDays" class="form-label">
                    Loan Duration (Days)
                </label>
                <input asp-for="LoanDurationDays" class="form-control" />
                <span asp-validation-for="LoanDurationDays"
                      class="text-danger"></span>
            </div>

            <!-- Renewal Limit -->
            <div class="form-group mb-3">
                <label asp-for="RenewalLimit" class="form-label">
                    Renewal Limit
                </label>
                <input asp-for="RenewalLimit" class="form-control" />
                <span asp-validation-for="RenewalLimit"
                      class="text-danger"></span>
            </div>

            <!-- Overdue Penalty -->
            <div class="form-group mb-3">
                <label asp-for="OverduePenaltyPerDay" class="form-label">
                    Overdue Penalty Per Day
                </label>
                <input asp-for="OverduePenaltyPerDay" class="form-control" />
                <span asp-validation-for="OverduePenaltyPerDay"
                      class="text-danger"></span>
            </div>

            <!-- Maximum Borrowable Items -->
            <div class="form-group mb-3">
                <label asp-for="MaxBorrowableItems" class="form-label">
                    Maximum Borrowable Items
                </label>
                <input asp-for="MaxBorrowableItems" class="form-control" />
                <span asp-validation-for="MaxBorrowableItems"
                      class="text-danger"></span>
            </div>

            <!-- Library -->
            <div class="form-group mb-4">
                <label asp-for="LibraryId" class="form-label">
                    Library
                </label>
                <select asp-for="LibraryId"
                        class="form-control"
                        asp-items="ViewBag.LibraryId">
                </select>
                <span asp-validation-for="LibraryId"
                      class="text-danger"></span>
            </div>

            <!-- Buttons -->
            <div class="button-group">
                <button type="submit" class="submit-btn">
                    Save Configuration
                </button>

                <a asp-action="Index" class="cancel-btn">
                    Cancel
                </a>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}