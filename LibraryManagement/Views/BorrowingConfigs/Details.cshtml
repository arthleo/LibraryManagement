@model LibraryManagement.Models.BorrowingConfig

@{
    ViewData["Title"] = "Borrowing Configuration Details";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/borrowingconfigdetails.css"
          asp-append-version="true" />
}

<div class="config-page">
    <div class="config-card">

        <p class="config-subtitle">LIBRARY MANAGEMENT SYSTEM</p>
        <h1>Borrowing Configuration Details</h1>
        <p class="config-text">
            View the borrowing rules set for this library.
        </p>

        <div class="details-section">

            <div class="detail-row">
                <span class="detail-label">Loan Duration (Days)</span>
                <span class="detail-value">@Model.LoanDurationDays</span>
            </div>

            <div class="detail-row">
                <span class="detail-label">Renewal Limit</span>
                <span class="detail-value">@Model.RenewalLimit</span>
            </div>

            <div class="detail-row">
                <span class="detail-label">Overdue Penalty Per Day</span>
                <span class="detail-value">@Model.OverduePenaltyPerDay</span>
            </div>

            <div class="detail-row">
                <span class="detail-label">Maximum Borrowable Items</span>
                <span class="detail-value">@Model.MaxBorrowableItems</span>
            </div>

            <div class="detail-row">
                <span class="detail-label">Library</span>
                <span class="detail-value">
                    @(Model.Library?.Name ?? "No Library Assigned")
                </span>
            </div>

            @if (Model.Library != null)
            {
                <div class="detail-row">
                    <span class="detail-label">Location</span>
                    <span class="detail-value">@Model.Library.Location</span>
                </div>

                <div class="detail-row">
                    <span class="detail-label">Operating Hours</span>
                    <span class="detail-value">@Model.Library.OperatingHours</span>
                </div>

                <div class="detail-row">
                    <span class="detail-label">Contact Details</span>
                    <span class="detail-value">@Model.Library.ContactDetails</span>
                </div>
            }

        </div>

        <div class="button-group">
            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="edit-btn">
                Edit Configuration
            </a>

            <a asp-action="Index"
               class="cancel-btn">
                Back to List
            </a>
        </div>

    </div>
</div>