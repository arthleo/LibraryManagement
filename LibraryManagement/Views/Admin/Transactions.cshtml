@model IEnumerable<LibraryManagement.Models.BorrowingTransaction>
@{
    ViewData["Title"] = "All Transactions";
}

<style>
    .dash { padding: 2rem 1.5rem; background: #f5f0e8; min-height: calc(100vh - 64px); font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; }
    .page-heading { font-size: 1.6rem; font-weight: 900; letter-spacing: -0.03em; color: #111; margin: 0 0 0.25rem; }
    .page-sub { font-size: 0.82rem; color: #666; margin: 0 0 2rem; }
    .back-link { font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: #c0392b; text-decoration: none; border-bottom: 1.5px solid #c0392b; display: inline-block; margin-bottom: 1.5rem; }
    .data-table { width: 100%; border-collapse: collapse; background: #fff; border: 2px solid #000; box-shadow: 4px 4px 0 #000; }
    .data-table th { font-size: 0.68rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; padding: 0.65rem 1rem; background: #111; color: #fff; text-align: left; border-right: 1px solid #333; }
    .data-table th:last-child { border-right: none; }
    .data-table td { font-size: 0.85rem; padding: 0.65rem 1rem; border-bottom: 1px solid #e0dbd0; border-right: 1px solid #e0dbd0; color: #222; vertical-align: middle; }
    .data-table td:last-child { border-right: none; }
    .data-table tr:last-child td { border-bottom: none; }
    .data-table tr:hover td { background: #faf8f3; }
    .overdue-row td { background: #fff5f5 !important; }
    .badge { display: inline-block; font-size: 0.65rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; padding: 0.2rem 0.5rem; border: 1.5px solid #000; }
    .badge--red    { background: #c0392b; color: #fff; }
    .badge--green  { background: #27ae60; color: #fff; }
    .badge--amber  { background: #f39c12; color: #000; }
    .btn { display: inline-block; padding: 0.35rem 0.75rem; font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; border: 1.5px solid #000; box-shadow: 2px 2px 0 #000; cursor: pointer; text-decoration: none; transition: all 0.15s ease; background: #fff; color: #111; }
    .btn:hover { box-shadow: 4px 4px 0 #000; transform: translate(-1px,-1px); }
    .btn--red { background: #c0392b; color: #fff; border-color: #000; }
    .fine-warning { color: #c0392b; font-weight: 700; }
    .empty-row { text-align: center; padding: 2rem !important; color: #999; font-size: 0.82rem; }

    /* Filter bar */
    .filter-bar { display: flex; gap: 0.75rem; margin-bottom: 1.25rem; flex-wrap: wrap; align-items: center; }
    .filter-btn { font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; padding: 0.4rem 0.85rem; border: 1.5px solid #000; background: #fff; cursor: pointer; transition: all 0.15s; box-shadow: 2px 2px 0 #000; }
    .filter-btn.active, .filter-btn:hover { background: #111; color: #fff; }
</style>

<div class="dash">
    <a href="/Admin" class="back-link">← Back to Dashboard</a>
    <h1 class="page-heading">All Transactions</h1>
    <p class="page-sub">@Model.Count() total borrowing records.</p>

    <div class="filter-bar">
        <button class="filter-btn active" onclick="filterTable('all', this)">All</button>
        <button class="filter-btn" onclick="filterTable('Borrowed', this)">Active</button>
        <button class="filter-btn" onclick="filterTable('Returned', this)">Returned</button>
        <button class="filter-btn" onclick="filterTable('overdue', this)">Overdue</button>
    </div>

    <table class="data-table" id="txTable">
        <thead>
            <tr>
                <th>#</th>
                <th>Book</th>
                <th>Member</th>
                <th>Borrowed</th>
                <th>Due Date</th>
                <th>Returned</th>
                <th>Status</th>
                <th>Fine</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr><td colspan="9" class="empty-row">No transactions yet</td></tr>
            }
            @foreach (var t in Model)
            {
                bool isOverdue   = t.Status == "Borrowed" && t.DueDate < DateTime.Now;
                bool isReturned  = t.Status == "Returned";
                string rowStatus = isOverdue ? "overdue" : t.Status;
                <tr class="@(isOverdue ? "overdue-row" : "")" data-status="@rowStatus">
                    <td style="color:#999; font-size:0.75rem">@t.Id</td>
                    <td>@(t.Book?.Title ?? "—")</td>
                    <td>@(t.User?.Email ?? "—")</td>
                    <td>@t.BorrowedAt.ToString("dd MMM yy")</td>
                    <td>
                        @t.DueDate.ToString("dd MMM yy")
                        @if (isOverdue)
                        {
                            <span class="badge badge--red" style="margin-left:4px">!</span>
                        }
                    </td>
                    <td>@(t.ReturnedAt.HasValue ? t.ReturnedAt.Value.ToString("dd MMM yy") : "—")</td>
                    <td>
                        @if (isOverdue)
                        {
                            <span class="badge badge--red">Overdue</span>
                        }
                        else if (isReturned)
                        {
                            <span class="badge badge--green">Returned</span>
                        }
                        else
                        {
                            <span class="badge badge--amber">Borrowed</span>
                        }
                    </td>
                    <td>
                        @if (t.FineAmount > 0)
                        {
                            <span class="fine-warning">$@t.FineAmount.ToString("0.00")</span>
                            @if (t.FinePaid) { <span style="color:#27ae60; font-size:0.75rem"> ✓ paid</span> }
                        }
                        else { <span style="color:#999">—</span> }
                    </td>
                    <td>
                        @if (t.Status == "Borrowed")
                        {
                            <form method="post" action="/Admin/MarkReturned" style="display:inline">
                                <input type="hidden" name="id" value="@t.Id" />
                                <button type="submit" class="btn btn--red">Return</button>
                            </form>
                        }
                        else
                        {
                            <span style="color:#999; font-size:0.78rem">Done</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<script>
function filterTable(status, btn) {
    document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    document.querySelectorAll('#txTable tbody tr[data-status]').forEach(row => {
        if (status === 'all') {
            row.style.display = '';
        } else {
            row.style.display = row.dataset.status === status ? '' : 'none';
        }
    });
}
</script>
