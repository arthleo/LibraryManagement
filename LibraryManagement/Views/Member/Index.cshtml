@{
    ViewData["Title"] = "My Library";

    var activeLoans =
        ViewBag.ActiveLoans
        as IEnumerable<LibraryManagement.Models.BorrowingTransaction>
        ?? [];

    var history =
        ViewBag.History
        as IEnumerable<LibraryManagement.Models.BorrowingTransaction>
        ?? [];

    var availableBooks =
        ViewBag.AvailableBooks
        as IEnumerable<LibraryManagement.Models.Book>
        ?? [];

    decimal unpaidFines =
        ViewBag.UnpaidFines ?? 0m;

    int overdueCount =
        ViewBag.OverdueCount ?? 0;
}

<style>
    .dash {
        padding: 2rem 1.5rem;
        background: #f5f0e8;
        min-height: calc(100vh - 64px);
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    }

    .page-heading {
        font-size: 1.6rem;
        font-weight: 900;
        color: #111;
        margin-bottom: 1.5rem;
    }

    .alert {
        padding: 1rem;
        margin-bottom: 1rem;
        border: 2px solid #000;
        box-shadow: 3px 3px 0 #000;
        font-weight: 700;
    }

    .alert--green {
        background: #e8fff0;
        color: #1b7d3c;
    }

    .alert--red {
        background: #fff1f1;
        color: #c0392b;
    }

    .stat-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
        gap: 1rem;
        margin-bottom: 2rem;
    }

    .stat-card {
        background: #fff;
        border: 2px solid #000;
        box-shadow: 4px 4px 0 #000;
        padding: 1rem;
    }

    .stat-card__label {
        font-size: 0.75rem;
        text-transform: uppercase;
        color: #666;
        font-weight: 700;
    }

    .stat-card__value {
        font-size: 1.8rem;
        font-weight: 900;
        margin-top: 0.4rem;
    }

    .section {
        margin-bottom: 2rem;
    }

    .section__header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1rem;
    }

    .section__title {
        font-size: 0.8rem;
        font-weight: 800;
        text-transform: uppercase;
        color: #333;
    }

    .book-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
        gap: 1rem;
    }

    .book-card {
        background: #fff;
        border: 2px solid #000;
        box-shadow: 3px 3px 0 #000;
        padding: 1rem;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .book-card__genre {
        font-size: 0.65rem;
        font-weight: 700;
        text-transform: uppercase;
        color: #c0392b;
    }

    .book-card__title {
        font-size: 0.95rem;
        font-weight: 800;
        color: #111;
    }

    .book-card__author {
        font-size: 0.8rem;
        color: #666;
    }

    .book-card__library {
        font-size: 0.72rem;
        color: #999;
    }

    .book-card__actions {
        margin-top: auto;
    }

    .btn {
        width: 100%;
        padding: 0.5rem;
        border: 1.5px solid #000;
        box-shadow: 2px 2px 0 #000;
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        cursor: pointer;
        text-align: center;
        display: inline-block;
    }

    .btn--red {
        background: #c0392b;
        color: white;
    }

    .btn--black {
        background: #111;
        color: white;
    }

    .loan-list {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .loan-card {
        background: #fff;
        border: 2px solid #000;
        box-shadow: 3px 3px 0 #000;
        padding: 1rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
    }

    .loan-card__title {
        font-weight: 800;
        color: #111;
    }

    .loan-card__author {
        font-size: 0.8rem;
        color: #666;
    }

    .loan-card__due {
        font-size: 0.75rem;
        font-weight: 700;
        margin-bottom: 0.5rem;
    }

    .table-box {
        background: #fff;
        border: 2px solid #000;
        box-shadow: 3px 3px 0 #000;
        overflow: hidden;
    }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    th {
        background: #111;
        color: #fff;
        font-size: 0.75rem;
        text-transform: uppercase;
        padding: 0.8rem;
    }

    td {
        padding: 0.8rem;
        border-top: 1px solid #ddd;
        font-size: 0.85rem;
    }
</style>

<div class="dash">

    @if (TempData["Success"] != null)
    {
        <div class="alert alert--green">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert--red">@TempData["Error"]</div>
    }

    <h1 class="page-heading">My Library</h1>

    <div class="stat-grid">
        <div class="stat-card">
            <div class="stat-card__label">Active Loans</div>
            <div class="stat-card__value">@activeLoans.Count()</div>
        </div>

        <div class="stat-card">
            <div class="stat-card__label">Books Read</div>
            <div class="stat-card__value">@history.Count()</div>
        </div>

        <div class="stat-card">
            <div class="stat-card__label">Available Books</div>
            <div class="stat-card__value">@availableBooks.Count()</div>
        </div>

        <div class="stat-card">
            <div class="stat-card__label">Overdue</div>
            <div class="stat-card__value">@overdueCount</div>
        </div>
    </div>

    <div class="section">
        <div class="section__header">
            <h2 class="section__title">Active Loans</h2>
        </div>

        <div class="loan-list">
            @if (!activeLoans.Any())
            {
                <div class="loan-card">No active loans.</div>
            }

            @foreach (var t in activeLoans)
            {
                <div class="loan-card">
                    <div>
                        <div class="loan-card__title">@(t.Book?.Title ?? "—")</div>
                        <div class="loan-card__author">@(t.Book?.Author ?? "—")</div>
                    </div>

                    <div style="min-width: 140px;">
                        <div class="loan-card__due">
                            Due: @t.DueDate.ToString("dd MMM yyyy")
                        </div>

                        <form asp-controller="Member"
                              asp-action="ReturnBook"
                              method="post">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="id"
                                   value="@t.Id" />

                            <button type="submit"
                                    class="btn btn--black">
                                Return
                            </button>
                        </form>
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="section">
        <div class="section__header">
            <h2 class="section__title">Recent History</h2>

            <a href="/Member/Browse"
               class="btn btn--red"
               style="width:auto; padding:0.5rem 1rem; text-decoration:none;">
                Browse Books
            </a>
        </div>

        <div class="table-box">
            <table>
                <thead>
                    <tr>
                        <th>Book</th>
                        <th>Returned</th>
                    </tr>
                </thead>

                <tbody>
                    @if (!history.Any())
                    {
                        <tr>
                            <td colspan="2">No borrowing history.</td>
                        </tr>
                    }

                    @foreach (var t in history)
                    {
                        <tr>
                            <td>@(t.Book?.Title ?? "—")</td>
                            <td>@(t.ReturnedAt?.ToString("dd MMM yyyy") ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="section">
        <div class="section__header">
            <h2 class="section__title">Available Books</h2>
        </div>

        <div class="book-grid">
            @foreach (var b in availableBooks)
            {
                <div class="book-card">
                    <div class="book-card__genre">@b.Genre</div>
                    <div class="book-card__title">@b.Title</div>
                    <div class="book-card__author">@b.Author</div>
                    <div class="book-card__library">📍 @(b.Library?.Name ?? "—")</div>

                    <div class="book-card__actions">
                        <form asp-controller="Member"
                              asp-action="Borrow"
                              method="post">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="bookId"
                                   value="@b.Id" />

                            <button type="submit"
                                    class="btn btn--red">
                                Borrow
                            </button>
                        </form>
                    </div>
                </div>
            }
        </div>
    </div>

</div>