@{
    ViewData["Title"] = "My Library";

    var activeLoans =
        ViewBag.ActiveLoans
        as IEnumerable<LibraryManagement.Models.BorrowingTransaction>
        ?? [];

    var history =
        ViewBag.History
        as IEnumerable<LibraryManagement.Models.BorrowingTransaction>
        ?? [];

    var availableBooks =
        ViewBag.AvailableBooks
        as IEnumerable<LibraryManagement.Models.Book>
        ?? [];

    var myReservations =
        ViewBag.MyReservations
        as IEnumerable<LibraryManagement.Models.Reservation>
        ?? [];

    decimal unpaidFines = ViewBag.UnpaidFines ?? 0m;
    int overdueCount = ViewBag.OverdueCount ?? 0;
}

<style>
    body {
        background-color: #f5f1e8;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .dash {
        min-height: 100vh;
        padding: 60px 20px;
        display: flex;
        justify-content: center;
    }

    .dashboard-card {
        width: 100%;
        max-width: 1400px;
        background: #ffffff;
        border: 3px solid #000;
        border-radius: 12px;
        box-shadow: 8px 8px 0 #000;
        padding: 50px;
    }

    /* Header */
    .page-subtitle {
        color: #ed7d3a;
        font-size: 14px;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
        margin-bottom: 10px;
    }

    .page-heading {
        font-size: 3rem;
        font-weight: 800;
        color: #111;
        margin-bottom: 10px;
    }

    .page-description {
        color: #666;
        font-size: 1.05rem;
        line-height: 1.7;
        margin-bottom: 30px;
    }

    /* Alerts */
    .alert {
        padding: 15px 20px;
        margin-bottom: 20px;
        border: 3px solid #000;
        border-radius: 12px;
        box-shadow: 4px 4px 0 #000;
        font-weight: 600;
    }

    .alert--green {
        background: #e8f7ed;
        color: #1f7a3d;
    }

    .alert--red {
        background: #fdeaea;
        color: #c63c2c;
    }

    /* Stats */
    .stat-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 20px;
        margin-bottom: 50px;
    }

    .stat-card {
        background: #faf7f2;
        border: 3px solid #000;
        border-radius: 12px;
        box-shadow: 4px 4px 0 #000;
        padding: 25px;
        text-align: center;
    }

    .stat-card__label {
        font-size: 0.85rem;
        font-weight: 700;
        text-transform: uppercase;
        color: #666;
        margin-bottom: 8px;
    }

    .stat-card__value {
        font-size: 2rem;
        font-weight: 800;
        color: #ed7d3a;
    }

    /* Sections */
    .section {
        margin-bottom: 60px;
    }

    .section__header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 15px;
        margin-bottom: 20px;
    }

    .section__title {
        font-size: 1.8rem;
        font-weight: 800;
        color: #111;
        margin: 0;
    }

    /* Buttons */
    .btn {
        display: inline-block;
        padding: 10px 20px;
        border: 3px solid #000;
        border-radius: 12px;
        box-shadow: 4px 4px 0 #000;
        font-weight: 700;
        text-transform: uppercase;
        font-size: 0.8rem;
        text-decoration: none;
        cursor: pointer;
        transition: all 0.2s ease;
    }

        .btn:hover {
            transform: translate(2px, 2px);
            box-shadow: 2px 2px 0 #000;
        }

    .btn--red {
        background: #ed7d3a;
        color: #fff;
    }

    .btn--black {
        background: #111;
        color: #fff;
    }

    .btn--yellow {
        background: #f4c542;
        color: #111;
    }

    /* Loan Cards */
    .loan-list {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .loan-card {
        background: #faf7f2;
        border: 3px solid #000;
        border-radius: 12px;
        box-shadow: 4px 4px 0 #000;
        padding: 25px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        flex-wrap: wrap;
    }

    .loan-card__title {
        font-size: 1.2rem;
        font-weight: 700;
        color: #111;
    }

    .loan-card__author {
        color: #666;
        margin-top: 5px;
    }

    .loan-card__due {
        font-size: 0.9rem;
        font-weight: 600;
        margin-bottom: 10px;
        color: #c63c2c;
    }

    /* Tables */
    .table-box {
        overflow-x: auto;
        background: #fff;
        border: 3px solid #000;
        border-radius: 12px;
        box-shadow: 4px 4px 0 #000;
    }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    thead {
        background: #111;
        color: #fff;
    }

    th,
    td {
        padding: 15px;
        text-align: left;
        border-bottom: 1px solid #e5e5e5;
    }

    tbody tr:hover {
        background: #faf7f2;
    }

    /* Status Badge */
    .status-badge {
        display: inline-block;
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 700;
        background: #fff3cd;
        color: #856404;
    }

    /* Book Grid */
    .book-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
        gap: 20px;
    }

    .book-card {
        background: #faf7f2;
        border: 3px solid #000;
        border-radius: 12px;
        box-shadow: 4px 4px 0 #000;
        overflow: hidden;
        display: flex;
        flex-direction: column;
    }

    .book-image {
        width: 100%;
        height: 300px;
        object-fit: cover;
        border-bottom: 3px solid #000;
        background: #f3f3f3;
    }

    .book-image-placeholder {
        width: 100%;
        height: 300px;
        border-bottom: 3px solid #000;
        background: #f3f3f3;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 4rem;
        color: #999;
    }

    .book-content {
        padding: 20px;
        display: flex;
        flex-direction: column;
        flex-grow: 1;
    }

    .book-card__genre {
        font-size: 0.75rem;
        font-weight: 700;
        color: #ed7d3a;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 8px;
    }

    .book-card__title {
        font-size: 1.1rem;
        font-weight: 700;
        color: #111;
        margin-bottom: 6px;
    }

    .book-card__author {
        color: #666;
        margin-bottom: 8px;
    }

    .book-card__library {
        color: #777;
        font-size: 0.9rem;
        margin-bottom: 15px;
    }

    .book-card__actions {
        margin-top: auto;
    }

    /* Empty State */
    .empty-message {
        text-align: center;
        padding: 30px;
        color: #777;
        font-weight: 600;
        background: #faf7f2;
        border: 3px solid #000;
        border-radius: 12px;
        box-shadow: 4px 4px 0 #000;
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .dashboard-card {
            padding: 30px 20px;
        }

        .page-heading {
            font-size: 2.2rem;
        }

        .section__header {
            flex-direction: column;
            align-items: stretch;
        }

        .loan-card {
            flex-direction: column;
            align-items: flex-start;
        }

        .btn {
            width: 100%;
            text-align: center;
        }

        .book-image,
        .book-image-placeholder {
            height: 250px;
        }
    }
</style>

<div class="dash">
    <div class="dashboard-card">

        @if (TempData["Success"] != null)
        {
            <div class="alert alert--green">@TempData["Success"]</div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert--red">@TempData["Error"]</div>
        }

        <p class="page-subtitle">MEMBER DASHBOARD</p>
        <h1 class="page-heading">My Library</h1>
        <p class="page-description">
            Manage your borrowed books, reservations, reading history and fines.
        </p>

        <!-- Statistics -->
        <div class="stat-grid">
            <div class="stat-card">
                <div class="stat-card__label">Active Loans</div>
                <div class="stat-card__value">@activeLoans.Count()</div>
            </div>

            <div class="stat-card">
                <div class="stat-card__label">Books Read</div>
                <div class="stat-card__value">@history.Count()</div>
            </div>

            <div class="stat-card">
                <div class="stat-card__label">Reservations</div>
                <div class="stat-card__value">@myReservations.Count()</div>
            </div>

            <div class="stat-card">
                <div class="stat-card__label">Overdue</div>
                <div class="stat-card__value">@overdueCount</div>
            </div>

            <div class="stat-card">
                <div class="stat-card__label">Unpaid Fines</div>
                <div class="stat-card__value">$@unpaidFines.ToString("0.00")</div>
            </div>
        </div>

        <!-- Active Loans -->
        <div class="section">
            <div class="section__header">
                <h2 class="section__title">📚 Active Loans</h2>
            </div>

            <div class="loan-list">
                @if (!activeLoans.Any())
                {
                    <div class="empty-message">No active loans.</div>
                }
                else
                {
                    @foreach (var t in activeLoans)
                    {
                        var config = ViewBag.Config as LibraryManagement.Models.BorrowingConfig;
                        int renewalLimit = config?.RenewalLimit ?? 2;
                        int renewalDays = config?.LoanDurationDays ?? 14;
                        int renewalsLeft = renewalLimit - t.RenewalsUsed;
                        bool canRenew = renewalsLeft > 0;
                        bool isOverdue = t.DueDate < DateTime.Now;

                        <div class="loan-card" style="@(isOverdue ? "border-color:#c0392b; background:#fff5f5;" : "")">
                            <div style="flex:1">
                                <div class="loan-card__title">@(t.Book?.Title ?? "—")</div>
                                <div class="loan-card__author">by @(t.Book?.Author ?? "—")</div>
                                <div class="loan-card__due" style="margin-top:8px">
                                    @if (isOverdue)
                                    {
                                        <span style="color:#c0392b">⚠ Overdue since @t.DueDate.ToString("dd MMM yyyy")</span>
                                    }
                                    else
                                    {
                                        <span>Due: @t.DueDate.ToString("dd MMM yyyy")</span>
                                    }
                                </div>
                                <!-- Renewal info -->
                                <div style="margin-top:8px; font-size:0.85rem; color:#666;">
                                    @if (canRenew)
                                    {
                                        <span>
                                            🔄 @renewalsLeft renewal@(renewalsLeft == 1 ? "" : "s") left
                                            — extends by @renewalDays days
                                        </span>
                                    }
                                    else
                                    {
                                        <span style="color:#c0392b">✗ No renewals left (@renewalLimit/@renewalLimit used)</span>
                                    }
                                </div>
                            </div>

                            <!-- Action buttons -->
                            <div style="display:flex; flex-direction:column; gap:10px; min-width:140px">

                                <!-- Renew button -->
                                @if (canRenew)
                                {
                                    <form asp-controller="Member"
                                          asp-action="Renew"
                                          method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@t.Id" />
                                        <button type="submit" class="btn btn--yellow"
                                                style="width:100%"
                                                onclick="return confirm('Renew \'@(t.Book?.Title?.Replace("'", "\'"))\' for another @renewalDays days?')">
                                            🔄 Renew
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <button class="btn" disabled
                                            style="width:100%; opacity:0.45; cursor:not-allowed; background:#eee; color:#999">
                                        🔄 No Renewals
                                    </button>
                                }

                                <!-- Return button -->
                                <form asp-controller="Member"
                                      asp-action="ReturnBook"
                                      method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@t.Id" />
                                    <button type="submit" class="btn btn--black"
                                            style="width:100%"
                                            onclick="return confirm('Return \'@(t.Book?.Title?.Replace("'", "\'"))\'?')">
                                        Return Book
                                    </button>
                                </form>

                            </div>
                        </div>
                    }
                }
            </div>
        </div>

        <!-- My Reservations -->
        <div class="section">
            <div class="section__header">
                <h2 class="section__title">📌 My Reservations</h2>
                <a href="/Member/Browse" class="btn btn--yellow">
                    Browse More
                </a>
            </div>

            <div class="table-box">
                <table>
                    <thead>
                        <tr>
                            <th>Book</th>
                            <th>Reserved At</th>
                            <th>Expiry Date</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!myReservations.Any())
                        {
                            <tr>
                                <td colspan="5">No active reservations.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var r in myReservations)
                            {
                                <tr>
                                    <td>@(r.Book?.Title ?? "—")</td>
                                    <td>@r.ReservedAt.ToString("dd MMM yyyy")</td>
                                    <td>@r.ExpiryDate.ToString("dd MMM yyyy")</td>
                                    <td>
                                        <span class="status-badge">@r.Status</span>
                                    </td>
                                    <td>
                                        <form asp-controller="Member"
                                              asp-action="CancelReservation"
                                              asp-route-id="@r.Id"
                                              method="post">
                                            @Html.AntiForgeryToken()
                                            <button type="submit"
                                                    class="btn btn--red"
                                                    onclick="return confirm('Cancel this reservation?');">
                                                Cancel
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Recent History -->
        <div class="section">
            <div class="section__header">
                <h2 class="section__title">📖 Recent History</h2>
                <a href="/Member/Browse" class="btn btn--red">
                    Browse Books
                </a>
            </div>

            <div class="table-box">
                <table>
                    <thead>
                        <tr>
                            <th>Book</th>
                            <th>Returned Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!history.Any())
                        {
                            <tr>
                                <td colspan="2">No borrowing history.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var t in history)
                            {
                                <tr>
                                    <td>@(t.Book?.Title ?? "—")</td>
                                    <td>@(t.ReturnedAt?.ToString("dd MMM yyyy") ?? "—")</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Available Books -->
        <div class="section">
            <div class="section__header">
                <h2 class="section__title">📚 Available Books</h2>
            </div>

            @if (!availableBooks.Any())
            {
                <div class="empty-message">
                    No available books right now.
                </div>
            }
            else
            {
                <div class="book-grid">
                    @foreach (var b in availableBooks)
                    {
                        <div class="book-card">

                            @if (!string.IsNullOrEmpty(b.CoverImagePath))
                            {
                                <img src="@b.CoverImagePath"
                                     alt="@b.Title"
                                     class="book-image" />
                            }
                            else
                            {
                                <div class="book-image-placeholder">
                                    📘
                                </div>
                            }

                            <div class="book-content">
                                <div class="book-card__genre">@b.Genre</div>
                                <div class="book-card__title">@b.Title</div>
                                <div class="book-card__author">by @b.Author</div>
                                <div class="book-card__library">
                                    📍 @(b.Library?.Name ?? "Unknown Library")
                                </div>

                                <div class="book-card__actions">
                                    <form asp-controller="Member"
                                          asp-action="Borrow"
                                          method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden"
                                               name="bookId"
                                               value="@b.Id" />
                                        <button type="submit"
                                                class="btn btn--red">
                                            Borrow Book
                                        </button>
                                    </form>
                                </div>
                            </div>

                        </div>
                    }
                </div>
            }
        </div>

    </div>
</div>