@model IEnumerable<LibraryManagement.Models.Book>

@{
    ViewData["Title"] = "Browse Books";

    var genres = ViewBag.Genres as IEnumerable<string> ?? [];
    string? search = ViewBag.Search;
    string? genre = ViewBag.Genre;
}

<style>
    body {
        background-color: #f5f1e8;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .dash {
        min-height: 100vh;
        padding: 60px 20px;
    }

    .page-heading {
        font-size: 3rem;
        font-weight: 800;
        color: #111;
        margin-bottom: 10px;
    }

    .page-sub {
        color: #666;
        font-size: 1.05rem;
        margin-bottom: 30px;
    }

    .back-link {
        display: inline-block;
        margin-bottom: 25px;
        color: #ed7d3a;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
        text-decoration: none;
    }

    .back-link:hover {
        color: #d96d2e;
    }

    /* Search Bar */
    .search-bar {
        display: flex;
        gap: 15px;
        flex-wrap: wrap;
        margin-bottom: 20px;
    }

    .search-input {
        flex: 1;
        min-width: 250px;
        padding: 14px 18px;
        border: 3px solid #000;
        border-radius: 12px;
        box-shadow: 4px 4px 0 #000;
        font-size: 15px;
        outline: none;
    }

    .search-btn,
    .clear-btn {
        padding: 14px 24px;
        border: 3px solid #000;
        border-radius: 12px;
        box-shadow: 4px 4px 0 #000;
        font-weight: 700;
        text-transform: uppercase;
        text-decoration: none;
        transition: all 0.2s ease;
    }

    .search-btn {
        background-color: #ed7d3a;
        color: white;
        cursor: pointer;
    }

    .clear-btn {
        background: white;
        color: #111;
        display: inline-flex;
        align-items: center;
    }

    .search-btn:hover,
    .clear-btn:hover {
        transform: translate(2px, 2px);
        box-shadow: 2px 2px 0 #000;
    }

    /* Genre Buttons */
    .genre-bar {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        margin-bottom: 20px;
    }

    .genre-btn {
        padding: 8px 16px;
        border: 3px solid #000;
        border-radius: 10px;
        background: white;
        color: #111;
        text-decoration: none;
        font-weight: 700;
        box-shadow: 3px 3px 0 #000;
        transition: all 0.2s ease;
    }

    .genre-btn:hover {
        transform: translate(2px, 2px);
        box-shadow: 1px 1px 0 #000;
    }

    .genre-btn.active {
        background: #111;
        color: white;
    }

    .genre-btn.active-red {
        background: #ed7d3a;
        color: white;
    }

    .results-count {
        color: #666;
        font-weight: 600;
        margin-bottom: 25px;
    }

    /* Book Grid */
    .book-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
        gap: 25px;
    }

    /* Book Card */
    .book-card {
        background: #fff;
        border: 3px solid #000;
        border-radius: 16px;
        box-shadow: 6px 6px 0 #000;
        padding: 20px;
        display: flex;
        flex-direction: column;
        transition: all 0.2s ease;
    }

    .book-card:hover {
        transform: translate(3px, 3px);
        box-shadow: 3px 3px 0 #000;
    }

    .book-card--unavailable {
        opacity: 0.85;
    }

    /* Book Cover Image */
    .book-card__image-wrap {
        width: 100%;
        height: 300px;
        border: 3px solid #000;
        border-radius: 12px;
        overflow: hidden;
        background: #f8f8f8;
        margin-bottom: 18px;
    }

    .book-card__image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    /* Book Info */
    .book-card__genre {
        font-size: 0.75rem;
        font-weight: 700;
        color: #ed7d3a;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 6px;
    }

    .book-card__title {
        font-size: 1.2rem;
        font-weight: 800;
        color: #111;
        margin-bottom: 6px;
    }

    .book-card__author {
        color: #666;
        margin-bottom: 8px;
    }

    .book-card__isbn,
    .book-card__lib {
        font-size: 0.85rem;
        color: #777;
        margin-bottom: 6px;
    }

    /* Status Badge */
    .badge {
        display: inline-block;
        padding: 6px 12px;
        border: 2px solid #000;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 700;
        margin-bottom: 15px;
        width: fit-content;
    }

    .badge--green {
        background: #27ae60;
        color: white;
    }

    .badge--gray {
        background: #d1d5db;
        color: #333;
    }

    /* Action Buttons */
    .btn {
        display: block;
        width: 100%;
        padding: 12px;
        border: 3px solid #000;
        border-radius: 10px;
        box-shadow: 3px 3px 0 #000;
        font-weight: 700;
        text-transform: uppercase;
        text-align: center;
        transition: all 0.2s ease;
        cursor: pointer;
    }

    .btn:hover {
        transform: translate(2px, 2px);
        box-shadow: 1px 1px 0 #000;
    }

    .btn--red {
        background: #ed7d3a;
        color: white;
    }

    .btn--black {
        background: #111;
        color: white;
    }

    /* No Results */
    .no-results {
        background: white;
        border: 3px solid #000;
        border-radius: 16px;
        box-shadow: 6px 6px 0 #000;
        padding: 40px;
        text-align: center;
        color: #666;
        font-weight: 600;
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .page-heading {
            font-size: 2.2rem;
        }

        .search-bar {
            flex-direction: column;
        }

        .search-btn,
        .clear-btn {
            width: 100%;
            text-align: center;
            justify-content: center;
        }

        .book-card__image-wrap {
            height: 250px;
        }
    }
</style>

<div class="dash">

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success mb-4">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger mb-4">
            @TempData["Error"]
        </div>
    }

    <a href="/Member" class="back-link">← Back to Dashboard</a>

    <h1 class="page-heading">Browse Books</h1>
    <p class="page-sub">
        Find your next read from the library collection.
    </p>

    <!-- Search Form -->
    <form method="get" action="/Member/Browse">
        <div class="search-bar">

            <input type="text"
                   name="search"
                   class="search-input"
                   placeholder="Search by title, author, or genre..."
                   value="@search" />

            <input type="hidden"
                   name="genre"
                   value="@genre" />

            <button type="submit" class="search-btn">
                Search
            </button>

            @if (!string.IsNullOrEmpty(search) || !string.IsNullOrEmpty(genre))
            {
                <a href="/Member/Browse" class="clear-btn">
                    Clear
                </a>
            }

        </div>
    </form>

    <!-- Genre Filters -->
    <div class="genre-bar">
        <a href="/Member/Browse"
           class="genre-btn @(string.IsNullOrEmpty(genre) ? "active" : "")">
            All
        </a>

        @foreach (var g in genres)
        {
            <a href="/Member/Browse?genre=@Uri.EscapeDataString(g)"
               class="genre-btn @(genre == g ? "active-red" : "")">
                @g
            </a>
        }
    </div>

    <p class="results-count">
        @Model.Count() book@(Model.Count() == 1 ? "" : "s") found
    </p>

    @if (!Model.Any())
    {
        <div class="no-results">
            No books found.
        </div>
    }
    else
    {
        <div class="book-grid">

            @foreach (var b in Model)
            {
                <div class="book-card @(!b.IsAvailable ? "book-card--unavailable" : "")">

                    <!-- Book Cover Image -->
                    <div class="book-card__image-wrap">
                        @if (!string.IsNullOrEmpty(b.CoverImagePath))
                        {
                            <img src="@b.CoverImagePath"
                                 alt="@b.Title"
                                 class="book-card__image"
                                 onerror="this.onerror=null; this.src='/images/no-book-cover.png';" />
                        }
                        else
                        {
                            <img src="/images/no-book-cover.png"
                                 alt="No Cover"
                                 class="book-card__image" />
                        }
                    </div>

                    <p class="book-card__genre">@b.Genre</p>
                    <h3 class="book-card__title">@b.Title</h3>
                    <p class="book-card__author">by @b.Author</p>
                    <p class="book-card__isbn">ISBN: @b.ISBN</p>
                    <p class="book-card__lib">
                        📍 @(b.Library?.Name ?? "Unknown Library")
                    </p>

                    @if (b.IsAvailable)
                    {
                        <span class="badge badge--green">Available</span>
                    }
                    else
                    {
                        <span class="badge badge--gray">Borrowed</span>
                    }

                    <div class="book-card__actions">
                        @if (b.IsAvailable)
                        {
                            <form asp-controller="Member"
                                  asp-action="Borrow"
                                  method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden"
                                       name="bookId"
                                       value="@b.Id" />

                                <button type="submit"
                                        class="btn btn--red">
                                    Borrow
                                </button>
                            </form>
                        }
                        else
                        {
                            <form asp-controller="Member"
                                  asp-action="Reserve"
                                  method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden"
                                       name="bookId"
                                       value="@b.Id" />

                                <button type="submit"
                                        class="btn btn--black">
                                    Reserve
                                </button>
                            </form>
                        }
                    </div>

                </div>
            }

        </div>
    }
</div>